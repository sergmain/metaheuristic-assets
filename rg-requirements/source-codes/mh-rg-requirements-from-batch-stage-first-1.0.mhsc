// Requirements from every file of one batch, into a fresh RG project, with NO requirement singled out: ONE STAGE is
// opened while the project is still EMPTY, before the fan-out; each file's branch stores its own requirements into
// that STAGE right after 'check'; the STAGE is committed once, after every branch.
//
// internal-1.0's graph with these changes, and nothing else:
//   open     mh.asset.rg-open-stage_1.0          after mkproject: RG's MCP mhdg_rg_open_stage WITHOUT a parent - RG
//                                               runs the project's own genesis pipeline with no requirement (an EMPTY
//                                               genesis, one COMMITTED snapshot) and forks ONE STAGE from it;
//                                               stageSnapshotId, genesisSnapshotId
//   in every file's branch, after check:
//     lines  mh.asset.rg-req-lines_1.0          the file's checked answer as one store-req line per requirement,
//                                               every line type DERIVED
//     reqs   internal mh.batch-line-splitter    one branch per requirement
//       store  internal mhdg-rg.store-req       the requirement written into the STAGE (it reads stageSnapshotId)
//   close    internal mhdg-rg.post-processing   the STAGE committed - marked FAILED if any Task of this ExecContext failed
//   gather and the top-level store are gone: nothing waits for every answer before storing starts.
//
// Why this shape: staged-1.3 split the batch into requirement #1 (the project's genesis) and the others, because a
// STAGE could only be forked from a COMMITTED snapshot and the genesis needed a requirement. RG now commits an EMPTY
// genesis, so the STAGE is opened on the empty project itself and every requirement goes into it the same way.
//
// Reusable by construction - nothing about a particular run appears below:
//   rgBaseUrl           comes IN, the RG the project is created in and the STAGE is opened in
//   locale              comes IN, the project's language
//   projectDescription  comes IN, what the requirements are for; the project's description and part of every prompt
//   rgPipelineUid       comes IN, the RG genesis pipeline the project is bound to - the one 'open' makes RG run
//   metaTable           comes IN, the meta-storage type holding the batch records
//   batchKey            comes IN, the record to process, e.g. batch-0004
//   synthetic           comes IN, 'true' reads in MH_META_STORAGE_SYNTHETIC, 'false' in MH_META_STORAGE
//   production          comes IN, NULLABLE (production?). Only an exact 'true' is production; null, absent or anything
//                       else is a development run
//   model               comes IN, REQUIRED (DAHF-IMPLEMENTATION 0.5) - the model cc runs with; recorded on the project,
//                       the genesis and the STAGE
//   effort?             comes IN, NULLABLE - the effort cc runs with, or null for a model that takes none (Haiku)
//   projectCode         goes OUT at ExecContext level
//
// NAMES THE RG FUNCTIONS READ: store-req and post-processing read 'projectCode' and 'stageSnapshotId' by those exact
// names. post-processing reads 'triggerEventId' only when it exists - there is none here: the STAGE was opened by RG's
// authoring service, not by internal mhdg-rg.open-stage.
//
// Credential: the vault entry RG_API_AUTH, declared by mh.asset.rg-temp-project_1.1 and mh.asset.rg-open-stage_1.0.
// Launch in the company of the RG_API_AUTH account. Launch with mh_create_exec_context_with_variables.
//
// ORDER is declaration order: each process is chained to the one declared before it; inside a branch the steps run in
// order; close waits for every branch.
//
// Carried over from internal-1.0 unchanged: mkproject, select, paths, and the branch's prompt, cc and check - cc is
// cached (cache on, cacheMeta) and runs mh.asset.call-cc_1.1, so import the call-cc bundle before this one; the batch
// record is NOT dropped, so the same batch can be run again.
source "mh-rg-requirements-from-batch-stage-first-1.0" {

    variables {
        <- rgBaseUrl
        <- locale
        <- projectDescription
        <- rgPipelineUid
        <- metaTable
        <- batchKey
        <- synthetic
        <- production?
        // model and effort are ExecContext-level inputs - a property of the RUN, not of this SourceCode, and never
        // left to the CLI's own default. Seed both at launch: claude-opus-4-8 / medium unless the run has a reason to
        // pin another pair. A null model is refused (01.562.124); effort is nullable - null for a model that takes no
        // effort (claude-haiku-4-5-20251001). Omitting either is refused (562.120).
        <- model
        <- effort?
        -> projectCode
    }

    mkproject := mh.asset.rg-temp-project_1.1 {
        name "Create the temporary RG project that will hold the requirements"
        meta variable-for-rg-base-url = "rgBaseUrl",
             variable-for-locale = "locale",
             variable-for-production = "production",
             variable-for-project-code = "projectCode",
             variable-for-description = "projectDescription",
             variable-for-rg-pipeline-uid = "rgPipelineUid",
             variable-for-model = "model",
             variable-for-effort = "effort",
             create-in-development = "true"
        <- rgBaseUrl, locale, production?, projectDescription, rgPipelineUid, model, effort?
        -> projectCode: ext=".txt"
        timeout 60
    }

    open := mh.asset.rg-open-stage_1.0 {
        name "Open ONE STAGE on the empty project - every branch stores into it"
        // RG runs the project's genesis with no requirement, waits for it to commit, and forks the STAGE from it; the
        // call returns only then. No 'tries': a second call would find the committed genesis and be refused (689.064).
        // Placed before the batch is read so that a run on an RG that cannot open it stops before any CC call.
        meta variable-for-rg-base-url = "rgBaseUrl",
             variable-for-project-code = "projectCode",
             variable-for-model = "model",
             variable-for-effort = "effort",
             variable-for-stage-snapshot-id = "stageSnapshotId",
             variable-for-genesis-snapshot-id = "genesisSnapshotId"
        <- rgBaseUrl, projectCode, model, effort?
        -> stageSnapshotId: ext=".txt",
           genesisSnapshotId: ext=".txt"
        timeout 900
    }

    select := internal mh.meta-storage {
        name "Read the batch record"
        meta action = "select",
             type = "metaTable",
             keys = "batchKey",
             synthetic = "synthetic",
             output = "batchRecords"
        <- metaTable, batchKey, synthetic
        -> batchRecords: ext=".json"
        timeout 120
        cache on
    }

    paths := mh.asset.rg-batch-paths_1.0 {
        name "Turn the batch record into its list of paths"
        meta variable-for-records = "batchRecords",
             variable-for-paths = "batchPaths"
        <- batchRecords
        -> batchPaths: ext=".txt"
        timeout 60
        cache on
    }

    split := internal mh.batch-line-splitter {
        name "One branch per file of the batch"
        meta number-of-lines-per-task = "1",
             variable-for-splitting = "batchPaths",
             output-is-dynamic = "true",
             output-variable = "sourcePath",
             is-array = "false"
        sequential {
            prompt := mh.asset.rg-req-path-prompt_1.0 {
                name "Read the file and build the CC prompt"
                meta variable-for-source-path = "sourcePath",
                     variable-for-description = "projectDescription",
                     variable-for-prompt = "ccPrompt"
                <- sourcePath, projectDescription
                -> ccPrompt: ext=".txt"
                timeout 60
            }

            cc := mh.asset.call-cc_1.1 {
                name "Ask CC for the file's requirements"
                // the process timeout must be larger than timeout-sec, or MH kills the Task before it can say why
                meta variable-for-prompt = "ccPrompt",
                     variable-for-output = "ccResult",
                     variable-for-model = "model",
                     variable-for-effort = "effort",
                     timeout-sec = "900"
                <- ccPrompt, model, effort?
                -> ccResult: ext=".txt"
                timeout 1200
                tries 2
                // model and effort are inputs (see the variables block), not literals - every run seeds the pair it
                // uses. As inputs their content is hashed into the cache key, so changing the model or effort a run
                // uses correctly misses the old entry; cacheMeta additionally keeps the prompt and timeout apart.
                cache on, cacheMeta
            }

            check := mh.asset.rg-req-check_1.0 {
                name "Check CC's answer and hand it on as one line"
                meta variable-for-source-path = "sourcePath",
                     variable-for-cc-result = "ccResult",
                     variable-for-answer = "reqAnswer"
                <- sourcePath, ccResult
                -> reqAnswer: ext=".txt"
                timeout 60
            }

            lines := mh.asset.rg-req-lines_1.0 {
                name "One line per requirement of the file, as store-req reads it, every line DERIVED"
                meta variable-for-answer = "reqAnswer",
                     variable-for-lines = "reqLines"
                <- reqAnswer
                -> reqLines: ext=".txt"
                timeout 60
            }

            reqs := internal mh.batch-line-splitter {
                name "One branch per requirement of the file"
                meta number-of-lines-per-task = "1",
                     variable-for-splitting = "reqLines",
                     output-is-dynamic = "true",
                     output-variable = "reqJson",
                     is-array = "false"
                <- reqLines
                sequential {
                    store := internal mhdg-rg.store-req {
                        name "Store the requirement into the STAGE"
                        // no 'tries': a retry after a write that landed would store the requirement twice
                        meta reqJson = "reqJson",
                             requirementId = "requirementId",
                             storeReqTaskId = "storeReqTaskId"
                        <- projectCode, reqJson: ext=".json", stageSnapshotId
                        -> requirementId: type=requirement-id, ext=".txt",
                           storeReqTaskId: type=store-req-task-id, ext=".txt"
                        timeout 60
                    }
                }
            }
        }
    }

    close := internal mhdg-rg.post-processing {
        name "Commit the STAGE - marked FAILED instead if any Task of this ExecContext failed"
        <- projectCode, stageSnapshotId
        timeout 60
        tag terminal
    }
}
