// Requirements from every file of one batch, into a fresh RG project: ONE STAGE opened on the still-EMPTY project
// before the fan-out, and every file's requirements stored from that file's own branch, right after 'check', by ONE
// store Task per file - into that STAGE. The STAGE is committed once, after every branch.
//
// internal-1.0's graph with these changes, and nothing else:
//   open     mh.asset.rg-open-stage_1.0          after mkproject: RG's MCP mhdg_rg_open_stage WITHOUT a parent - RG
//                                               runs the project's own genesis with no requirement and forks ONE
//                                               STAGE from it; stageSnapshotId, genesisSnapshotId
//   store    moved from the top level into split, after check: mh.asset.rg-req-store-stage_1.0 - the branch's file
//            (sourcePath) and its answer (reqAnswer) written into the STAGE named by stageSnapshotId, one Task per
//            file, through RG's requirements/manual (addManualDerivedRequirement, STAGE mode)
//   gather   gone: nothing waits for every answer before storing starts
//   close    internal mhdg-rg.post-processing   the STAGE committed - marked FAILED if any Task of this ExecContext failed
//
// Why not internal-1.0's own store (mhdg-rg.req-store-batch) in the branch: it takes no STAGE and starts every call
// with the project's genesis, which RG refuses once the project owns a snapshot - ExecContext #33 (DETAILS 12.7 E2).
//
// Reusable by construction - nothing about a particular run appears below. Inputs as internal-1.0 (DETAILS 8.3),
// effort nullable (effort?, DETAILS 11.3). Output projectCode at ExecContext level; reqIds / reqSources per branch.
//
// Credential: the vault entry RG_API_AUTH, declared by mh.asset.rg-temp-project_1.1, mh.asset.rg-open-stage_1.0 and
// mh.asset.rg-req-store-stage_1.0. Launch in the company of the RG_API_AUTH account. Launch with
// mh_create_exec_context_with_variables.
//
// ORDER is declaration order: each process is chained to the one declared before it; inside a branch the steps run in
// order; close waits for every branch.
source "mh-rg-requirements-from-batch-stage-store-1.0" {

    variables {
        <- rgBaseUrl
        <- locale
        <- projectDescription
        <- rgPipelineUid
        <- metaTable
        <- batchKey
        <- synthetic
        <- production?
        // model and effort are ExecContext-level inputs - a property of the RUN, not of this SourceCode, and never
        // left to the CLI's own default. A null model is refused (01.562.124); effort is nullable - null for a model
        // that takes no effort (claude-haiku-4-5-20251001). Omitting either is refused (562.120).
        <- model
        <- effort?
        -> projectCode
    }

    mkproject := mh.asset.rg-temp-project_1.1 {
        name "Create the temporary RG project that will hold the requirements"
        meta variable-for-rg-base-url = "rgBaseUrl",
             variable-for-locale = "locale",
             variable-for-production = "production",
             variable-for-project-code = "projectCode",
             variable-for-description = "projectDescription",
             variable-for-rg-pipeline-uid = "rgPipelineUid",
             variable-for-model = "model",
             variable-for-effort = "effort",
             create-in-development = "true"
        <- rgBaseUrl, locale, production?, projectDescription, rgPipelineUid, model, effort?
        -> projectCode: ext=".txt"
        timeout 60
    }

    open := mh.asset.rg-open-stage_1.0 {
        name "Open ONE STAGE on the empty project - every branch stores into it"
        // no 'tries': a second call would find the committed genesis and be refused (689.064)
        meta variable-for-rg-base-url = "rgBaseUrl",
             variable-for-project-code = "projectCode",
             variable-for-model = "model",
             variable-for-effort = "effort",
             variable-for-stage-snapshot-id = "stageSnapshotId",
             variable-for-genesis-snapshot-id = "genesisSnapshotId"
        <- rgBaseUrl, projectCode, model, effort?
        -> stageSnapshotId: ext=".txt",
           genesisSnapshotId: ext=".txt"
        timeout 900
    }

    select := internal mh.meta-storage {
        name "Read the batch record"
        meta action = "select",
             type = "metaTable",
             keys = "batchKey",
             synthetic = "synthetic",
             output = "batchRecords"
        <- metaTable, batchKey, synthetic
        -> batchRecords: ext=".json"
        timeout 120
        cache on
    }

    paths := mh.asset.rg-batch-paths_1.0 {
        name "Turn the batch record into its list of paths"
        meta variable-for-records = "batchRecords",
             variable-for-paths = "batchPaths"
        <- batchRecords
        -> batchPaths: ext=".txt"
        timeout 60
        cache on
    }

    split := internal mh.batch-line-splitter {
        name "One branch per file of the batch"
        meta number-of-lines-per-task = "1",
             variable-for-splitting = "batchPaths",
             output-is-dynamic = "true",
             output-variable = "sourcePath",
             is-array = "false"
        sequential {
            prompt := mh.asset.rg-req-path-prompt_1.0 {
                name "Read the file and build the CC prompt"
                meta variable-for-source-path = "sourcePath",
                     variable-for-description = "projectDescription",
                     variable-for-prompt = "ccPrompt"
                <- sourcePath, projectDescription
                -> ccPrompt: ext=".txt"
                timeout 60
            }

            cc := mh.asset.call-cc_1.1 {
                name "Ask CC for the file's requirements"
                // the process timeout must be larger than timeout-sec, or MH kills the Task before it can say why
                meta variable-for-prompt = "ccPrompt",
                     variable-for-output = "ccResult",
                     variable-for-model = "model",
                     variable-for-effort = "effort",
                     timeout-sec = "900"
                <- ccPrompt, model, effort?
                -> ccResult: ext=".txt"
                timeout 1200
                tries 2
                // model and effort are inputs (see the variables block), not literals - every run seeds the pair it
                // uses. As inputs their content is hashed into the cache key, so changing the model or effort a run
                // uses correctly misses the old entry; cacheMeta additionally keeps the prompt and timeout apart.
                cache on, cacheMeta
            }

            check := mh.asset.rg-req-check_1.0 {
                name "Check CC's answer and hand it on as one line"
                meta variable-for-source-path = "sourcePath",
                     variable-for-cc-result = "ccResult",
                     variable-for-answer = "reqAnswer"
                <- sourcePath, ccResult
                -> reqAnswer: ext=".txt"
                timeout 60
            }

            store := mh.asset.rg-req-store-stage_1.0 {
                name "Store this file's requirements into the STAGE"
                // one Task per file, right after check; the file's requirements written into the open STAGE. No
                // 'tries': a retry after writes that landed would store them twice.
                meta variable-for-rg-base-url = "rgBaseUrl",
                     variable-for-project-code = "projectCode",
                     variable-for-stage-snapshot-id = "stageSnapshotId",
                     variable-for-paths = "sourcePath",
                     variable-for-answers = "reqAnswer",
                     variable-for-req-ids = "reqIds",
                     variable-for-req-sources = "reqSources"
                <- rgBaseUrl, projectCode, stageSnapshotId, sourcePath, reqAnswer
                -> reqIds: ext=".txt",
                   reqSources: ext=".txt"
                timeout 1800
            }
        }
    }

    close := internal mhdg-rg.post-processing {
        name "Commit the STAGE - marked FAILED instead if any Task of this ExecContext failed"
        <- projectCode, stageSnapshotId
        timeout 60
        tag terminal
    }
}
