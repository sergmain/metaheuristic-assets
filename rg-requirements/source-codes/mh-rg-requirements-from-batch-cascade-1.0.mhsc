// Requirements from every file of one batch, into a fresh RG project: one CC call per file, in parallel, and every
// requirement stored IN ITS OWN BRANCH, as soon as its file's answer is checked - into ONE STAGE that is opened once,
// before the fan-out, and committed once, after it. The store is RG's own cascade, the one its pipeline runs:
// internal mhdg-rg.open-stage, internal mhdg-rg.store-req per requirement, internal mhdg-rg.post-processing.
//
// Why not mhdg-rg.req-store-batch in the branches (mh-rg-requirements-from-batch-parallel-1.0, archived): that
// Function spends the project's one-shot genesis on requirement #1 of EVERY call, so the second branch was refused -
// 04.876.020 "Project ... already owns 1 snapshot(s)" (ExecContext #8). Here the genesis is a STAGE opened ONCE with
// the fork point named explicitly as genesis, and a branch only writes into it: nothing in a branch waits.
//
// A temporary RG project is created - for real, in development runs too - with the given description and an RG
// genesis pipeline. One record of a meta table (the output of a dir-batcher run) lists the files, one absolute path
// per line. mh.batch-line-splitter gives every file a branch of its own: read the file, ask CC for its requirements,
// check CC's answer, turn it into one line per requirement, and store each line into the STAGE in a branch of its own.
//
// Reusable by construction - nothing about a particular run appears below:
//   rgBaseUrl           comes IN, the RG to create the project in, e.g. http://localhost:64967. Only mkproject uses it
//   locale              comes IN, the project's language
//   projectDescription  comes IN, what the requirements are for; the project's description and part of every prompt
//   rgPipelineUid       comes IN, the RG genesis pipeline the project is bound to
//   metaTable           comes IN, the meta-storage type holding the batch records
//   batchKey            comes IN, the record to process, e.g. batch-0004
//   synthetic           comes IN, 'true' reads in MH_META_STORAGE_SYNTHETIC, 'false' in MH_META_STORAGE
//   production          comes IN, NULLABLE (production?). Only an exact 'true' is production; null, absent or anything
//                       else is a development run
//   model, effort       come IN, REQUIRED (DAHF-IMPLEMENTATION 0.5) - the pair cc runs with; mkproject records it on
//                       the project, open-stage stamps it on the STAGE (it reads the Variables 'model' and 'effort')
//   projectCode         goes OUT at ExecContext level
//   requirementId       goes OUT per requirement branch - the id RG gave that requirement
//
// NAMES THE RG FUNCTIONS READ. mhdg-rg.open-stage, mhdg-rg.store-req and mhdg-rg.post-processing read 'projectCode',
// 'parentSnapshotId', 'stageSnapshotId' and 'triggerEventId' by those exact names - the Variables below carry them.
//
// THIS ExecContext IS THE PROJECT'S PIPELINE RUN. open-stage records this ExecContext on the genesis STAGE and opens a
// PIPELINE_RUN event; post-processing commits the STAGE and completes the event - as RG's own genesis pipeline does.
// post-processing is fail-closed: if any Task of this ExecContext ended in ERROR, the STAGE is marked FAILED, not
// committed - every file or nothing.
//
// WHOSE PROJECT. mkproject creates the project over REST as the RG_API_AUTH account; store-req writes as the company
// the project belongs to. Launch in the company of the RG_API_AUTH account.
//
// Launch with mh_create_exec_context_with_variables; mh_create_exec_context refuses a SourceCode that declares
// source-level inputs (562.120).
//
// ORDER is declaration order: each process is chained to the one declared before it; inside a branch, the steps run
// in order; commit waits for every branch.
//
// Carried over from internal-1.0 unchanged: mkproject, select, paths, and the branch's prompt, cc and check - cc is
// cached (cache on, cacheMeta) and runs mh.asset.call-cc_1.1, so import the call-cc bundle before this one; the batch
// record is NOT dropped, so the same batch can be run again.
source "mh-rg-requirements-from-batch-cascade-1.0" {

    variables {
        <- rgBaseUrl
        <- locale
        <- projectDescription
        <- rgPipelineUid
        <- metaTable
        <- batchKey
        <- synthetic
        <- production?
        // model and effort are REQUIRED ExecContext-level inputs - a property of the RUN, not of this SourceCode,
        // and never left to the CLI's own default. Seed both at launch: claude-opus-4-8 / medium unless the run has a
        // reason to pin another pair. A null for either is refused (01.562.124), an omitted one too (562.120).
        <- model
        <- effort
        -> projectCode
    }

    mkproject := mh.asset.rg-temp-project_1.1 {
        name "Create the temporary RG project that will hold the requirements"
        meta variable-for-rg-base-url = "rgBaseUrl",
             variable-for-locale = "locale",
             variable-for-production = "production",
             variable-for-project-code = "projectCode",
             variable-for-description = "projectDescription",
             variable-for-rg-pipeline-uid = "rgPipelineUid",
             variable-for-model = "model",
             variable-for-effort = "effort",
             create-in-development = "true"
        <- rgBaseUrl, locale, production?, projectDescription, rgPipelineUid, model, effort
        -> projectCode: ext=".txt"
        timeout 60
    }

    select := internal mh.meta-storage {
        name "Read the batch record"
        meta action = "select",
             type = "metaTable",
             keys = "batchKey",
             synthetic = "synthetic",
             output = "batchRecords"
        <- metaTable, batchKey, synthetic
        -> batchRecords: ext=".json"
        timeout 120
        cache on
    }

    paths := mh.asset.rg-batch-paths_1.0 {
        name "Turn the batch record into its list of paths"
        meta variable-for-records = "batchRecords",
             variable-for-paths = "batchPaths"
        <- batchRecords
        -> batchPaths: ext=".txt"
        timeout 60
        cache on
    }

    genesis := internal mh.evaluation {
        name "Name the fork point: genesis - the project mkproject created owns no snapshot"
        // a SpEL string literal: the Variable holds the TEXT null, which open-stage reads as an explicit genesis. A
        // bare null would nullify the Variable, and open-stage refuses an empty fork point (844.022)
        -> parentSnapshotId: ext=".txt"
        meta expression = "parentSnapshotId = 'null'"
    }

    open := internal mhdg-rg.open-stage {
        name "Open the project's genesis STAGE - every branch stores into it"
        <- projectCode, parentSnapshotId
        -> stageSnapshotId: type=stage-snapshot-id, ext=".txt",
           triggerEventId: type=event-id, ext=".txt"
        timeout 30
    }

    split := internal mh.batch-line-splitter {
        name "One branch per file of the batch"
        meta number-of-lines-per-task = "1",
             variable-for-splitting = "batchPaths",
             output-is-dynamic = "true",
             output-variable = "sourcePath",
             is-array = "false"
        sequential {
            prompt := mh.asset.rg-req-path-prompt_1.0 {
                name "Read the file and build the CC prompt"
                meta variable-for-source-path = "sourcePath",
                     variable-for-description = "projectDescription",
                     variable-for-prompt = "ccPrompt"
                <- sourcePath, projectDescription
                -> ccPrompt: ext=".txt"
                timeout 60
            }

            cc := mh.asset.call-cc_1.1 {
                name "Ask CC for the file's requirements"
                // the process timeout must be larger than timeout-sec, or MH kills the Task before it can say why
                meta variable-for-prompt = "ccPrompt",
                     variable-for-output = "ccResult",
                     variable-for-model = "model",
                     variable-for-effort = "effort",
                     timeout-sec = "900"
                <- ccPrompt, model, effort
                -> ccResult: ext=".txt"
                timeout 1200
                tries 2
                // model and effort are required inputs (see the variables block), not literals - every run seeds the
                // pair it uses. As inputs their content is hashed into the cache key, so changing the model or
                // effort a run uses correctly misses the old entry; cacheMeta additionally keeps the prompt and
                // timeout apart.
                cache on, cacheMeta
            }

            check := mh.asset.rg-req-check_1.0 {
                name "Check CC's answer and hand it on as one line"
                meta variable-for-source-path = "sourcePath",
                     variable-for-cc-result = "ccResult",
                     variable-for-answer = "reqAnswer"
                <- sourcePath, ccResult
                -> reqAnswer: ext=".txt"
                timeout 60
            }

            lines := mh.asset.rg-req-lines_1.0 {
                name "One line per requirement, as store-req reads it"
                meta variable-for-answer = "reqAnswer",
                     variable-for-lines = "reqLines"
                <- reqAnswer
                -> reqLines: ext=".txt"
                timeout 60
            }

            reqs := internal mh.batch-line-splitter {
                name "One branch per requirement of the file"
                meta number-of-lines-per-task = "1",
                     variable-for-splitting = "reqLines",
                     output-is-dynamic = "true",
                     output-variable = "reqJson",
                     is-array = "false"
                <- reqLines
                sequential {
                    store := internal mhdg-rg.store-req {
                        name "Store the requirement into the STAGE"
                        meta reqJson = "reqJson",
                             requirementId = "requirementId",
                             storeReqTaskId = "storeReqTaskId"
                        <- projectCode, reqJson: ext=".json", stageSnapshotId
                        -> requirementId: type=requirement-id, ext=".txt",
                           storeReqTaskId: type=store-req-task-id, ext=".txt"
                        timeout 60
                    }
                }
            }
        }
    }

    commit := internal mhdg-rg.post-processing {
        name "Commit the STAGE - marked FAILED instead if any Task of this ExecContext failed"
        <- projectCode, stageSnapshotId, triggerEventId
        timeout 60
        tag terminal
    }
}
