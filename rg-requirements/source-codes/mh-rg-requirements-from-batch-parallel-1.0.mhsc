// Requirements from every file of one batch, into a fresh RG project: one CC call per file, in parallel, and each
// file's requirements stored IN ITS OWN BRANCH, right after its answer is checked - by the internal Function
// mhdg-rg.req-store-batch, handed that one file and that one answer.
//
// This is mh-rg-requirements-from-batch-internal-1.0 with a different flow: its 'gather' (mh.aggregate) and its
// top-level 'store' are removed, and 'store' runs inside the splitter's sequential block, after 'check'. A changed
// flow is a new SourceCode beside its predecessor, not a version bump - internal-1.0 is left as it is and keeps
// working.
//
// A temporary RG project is created - for real, in development runs too - with the given description and an RG
// genesis pipeline. One record of a meta table (the output of a dir-batcher run) lists the files, one absolute
// path per line. mh.batch-line-splitter gives every file a branch of its own: read the file, ask CC for its
// requirements, check CC's answer, store the answer's requirements in the project.
//
// Reusable by construction - nothing about a particular run appears below:
//   rgBaseUrl           comes IN, the RG to create the project in, e.g. http://localhost:64967. Only mkproject
//                       uses it; the store runs inside RG
//   locale              comes IN, the project's language
//   projectDescription  comes IN, what the requirements are for; the project's description and part of every
//                       prompt
//   rgPipelineUid       comes IN, the RG genesis pipeline the project runs
//   metaTable           comes IN, the meta-storage type holding the batch records
//   batchKey            comes IN, the record to process, e.g. batch-0004
//   synthetic           comes IN, 'true' reads in MH_META_STORAGE_SYNTHETIC, 'false' in MH_META_STORAGE
//   production          comes IN, NULLABLE (production?). Only an exact 'true' is production; null, absent or
//                       anything else is a development run
//   model, effort       come IN, REQUIRED (DAHF-IMPLEMENTATION 0.5) - the pair cc runs with; mkproject records it
//                       on the project, the store on what it commits
//   projectCode         goes OUT at ExecContext level
//   reqIds, reqSources  go OUT per BRANCH - each branch's store writes the ids of its own file's requirements; with
//                       no gather there is no ExecContext-level list
//
// WHOSE PROJECT. mkproject creates the project over REST as the RG_API_AUTH account, so the project belongs to
// that account's company. The internal store has no credential: it writes as the company of THIS ExecContext.
// Both must be the same company - launch this SourceCode in the company the RG_API_AUTH account belongs to.
//
// Launch with mh_create_exec_context_with_variables; mh_create_exec_context refuses a SourceCode that declares
// source-level inputs (562.120).
//
// ORDER is declaration order: each process is chained to the one declared before it; inside a branch, store runs
// after check.
//
// Carried over from internal-1.0 unchanged: mkproject, select, paths, and the branch's prompt, cc and check - cc is
// cached (cache on, cacheMeta) and runs mh.asset.call-cc_1.1, so import the call-cc bundle before this one; the
// batch record is NOT dropped, so the same batch can be run again.
// Needs the RG build that registers the internal Function mhdg-rg.req-store-batch.
source "mh-rg-requirements-from-batch-parallel-1.0" {

    variables {
        <- rgBaseUrl
        <- locale
        <- projectDescription
        <- rgPipelineUid
        <- metaTable
        <- batchKey
        <- synthetic
        <- production?
        // model and effort are REQUIRED ExecContext-level inputs - a property of the RUN, not of this SourceCode,
        // and never left to the CLI's own default. Seed both at launch: claude-opus-4-8 / medium unless the run has a
        // reason to pin another pair. A null for either is refused (01.562.124), an omitted one too (562.120).
        <- model
        <- effort
        -> projectCode
    }

    mkproject := mh.asset.rg-temp-project_1.1 {
        name "Create the temporary RG project that will hold the requirements"
        meta variable-for-rg-base-url = "rgBaseUrl",
             variable-for-locale = "locale",
             variable-for-production = "production",
             variable-for-project-code = "projectCode",
             variable-for-description = "projectDescription",
             variable-for-rg-pipeline-uid = "rgPipelineUid",
             variable-for-model = "model",
             variable-for-effort = "effort",
             create-in-development = "true"
        <- rgBaseUrl, locale, production?, projectDescription, rgPipelineUid, model, effort
        -> projectCode: ext=".txt"
        timeout 60
    }

    select := internal mh.meta-storage {
        name "Read the batch record"
        meta action = "select",
             type = "metaTable",
             keys = "batchKey",
             synthetic = "synthetic",
             output = "batchRecords"
        <- metaTable, batchKey, synthetic
        -> batchRecords: ext=".json"
        timeout 120
        cache on
    }

    paths := mh.asset.rg-batch-paths_1.0 {
        name "Turn the batch record into its list of paths"
        meta variable-for-records = "batchRecords",
             variable-for-paths = "batchPaths"
        <- batchRecords
        -> batchPaths: ext=".txt"
        timeout 60
        cache on
    }

    split := internal mh.batch-line-splitter {
        name "One branch per file of the batch"
        meta number-of-lines-per-task = "1",
             variable-for-splitting = "batchPaths",
             output-is-dynamic = "true",
             output-variable = "sourcePath",
             is-array = "false"
        sequential {
            prompt := mh.asset.rg-req-path-prompt_1.0 {
                name "Read the file and build the CC prompt"
                meta variable-for-source-path = "sourcePath",
                     variable-for-description = "projectDescription",
                     variable-for-prompt = "ccPrompt"
                <- sourcePath, projectDescription
                -> ccPrompt: ext=".txt"
                timeout 60
            }

            cc := mh.asset.call-cc_1.1 {
                name "Ask CC for the file's requirements"
                // the process timeout must be larger than timeout-sec, or MH kills the Task before it can say why
                meta variable-for-prompt = "ccPrompt",
                     variable-for-output = "ccResult",
                     variable-for-model = "model",
                     variable-for-effort = "effort",
                     timeout-sec = "900"
                <- ccPrompt, model, effort
                -> ccResult: ext=".txt"
                timeout 1200
                tries 2
                // model and effort are required inputs (see the variables block), not literals - every run seeds the
                // pair it uses. As inputs their content is hashed into the cache key, so changing the model or
                // effort a run uses correctly misses the old entry; cacheMeta additionally keeps the prompt and
                // timeout apart.
                cache on, cacheMeta
            }

            check := mh.asset.rg-req-check_1.0 {
                name "Check CC's answer and hand it on as one line"
                meta variable-for-source-path = "sourcePath",
                     variable-for-cc-result = "ccResult",
                     variable-for-answer = "reqAnswer"
                <- sourcePath, ccResult
                -> reqAnswer: ext=".txt"
                timeout 60
            }

            store := internal mhdg-rg.req-store-batch {
                name "Store this file's requirements in the project"
                // runs INSIDE RG, as this ExecContext's company, once per branch: the batch it is handed is this
                // branch's one path, and the answers are this branch's one answer. The same metas as the top-level
                // store of internal-1.0, bound to the branch's own Variables. No 'tries': an answer the store refuses
                // is refused the same way again.
                meta variable-for-project-code = "projectCode",
                     variable-for-paths = "sourcePath",
                     variable-for-answers = "reqAnswer",
                     variable-for-req-ids = "reqIds",
                     variable-for-req-sources = "reqSources",
                     variable-for-model = "model",
                     variable-for-effort = "effort"
                <- projectCode, sourcePath, reqAnswer, model, effort
                -> reqIds: ext=".txt",
                   reqSources: ext=".txt"
                timeout 14400
            }
        }
    }
}
