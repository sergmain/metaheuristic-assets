// Requirements from every file of one batch, into a fresh RG project: one CC call per file, in parallel; then
// requirement #1 through the project's genesis, and every other requirement written IN PARALLEL, one branch each, into
// ONE STAGE forked from the genesis and committed once.
//
// internal-1.0's graph up to and including 'gather', then:
//   first    mh.asset.rg-req-first_1.0          the collected answers split into requirement #1 (firstPath +
//                                               firstAnswer) and every other requirement (otherReqs, one per line)
//   insert   internal mh.nop, gated on hasFirstReq, holding in order:
//     genesis  internal mhdg-rg.req-store-batch   the batch store handed ONE file and ONE requirement: the genesis
//     parent   mh.asset.rg-genesis-snapshot_1.0   that genesis snapshot's id - the fork point open-stage needs by name
//     open     internal mhdg-rg.open-stage        ONE STAGE forked from it
//     reqs     internal mh.batch-line-splitter    one branch per other requirement
//       store  internal mhdg-rg.store-req         the requirement written into the STAGE
//     close    internal mhdg-rg.post-processing   the STAGE committed - marked FAILED if any Task of this ExecContext failed
//
// Why this shape: mhdg-rg.req-store-batch runs the project's one-shot genesis on EVERY call, so it can run only once
// per project (ExecContext #8, 04.876.020); here it runs once, on requirement #1 alone. The other writes are RG's own
// cascade Functions, which write into an OPEN STAGE and never touch the genesis.
//
// Reusable by construction - nothing about a particular run appears below:
//   rgBaseUrl           comes IN, the RG the project is created in, and the one parent reads the genesis id from
//   locale              comes IN, the project's language
//   projectDescription  comes IN, what the requirements are for; the project's description and part of every prompt
//   rgPipelineUid       comes IN, the RG genesis pipeline the project runs
//   metaTable           comes IN, the meta-storage type holding the batch records
//   batchKey            comes IN, the record to process, e.g. batch-0004
//   synthetic           comes IN, 'true' reads in MH_META_STORAGE_SYNTHETIC, 'false' in MH_META_STORAGE
//   production          comes IN, NULLABLE (production?). Only an exact 'true' is production; null, absent or anything
//                       else is a development run
//   model, effort       come IN, REQUIRED (DAHF-IMPLEMENTATION 0.5) - the pair cc runs with; recorded on the project,
//                       the genesis and the STAGE
//   projectCode         goes OUT at ExecContext level
//
// NAMES THE RG FUNCTIONS READ: open-stage, store-req and post-processing read 'projectCode', 'parentSnapshotId',
// 'stageSnapshotId' and 'triggerEventId' by those exact names; open-stage stamps the STAGE from 'model' / 'effort'.
//
// Credential: the vault entry RG_API_AUTH, declared by mh.asset.rg-temp-project_1.1 and mh.asset.rg-genesis-snapshot_1.0.
// Launch in the company of the RG_API_AUTH account. Launch with mh_create_exec_context_with_variables.
//
// ORDER is declaration order: each process is chained to the one declared before it; everything after the splitter
// waits for all of its branches; inside 'insert' the steps run in the order above.
source "mh-rg-requirements-from-batch-staged-1.0" {

    variables {
        <- rgBaseUrl
        <- locale
        <- projectDescription
        <- rgPipelineUid
        <- metaTable
        <- batchKey
        <- synthetic
        <- production?
        // model and effort are REQUIRED ExecContext-level inputs - a property of the RUN, not of this SourceCode,
        // and never left to the CLI's own default. Seed both at launch: claude-opus-4-8 / medium unless the run has a
        // reason to pin another pair. A null for either is refused (01.562.124), an omitted one too (562.120).
        <- model
        <- effort
        -> projectCode
    }

    mkproject := mh.asset.rg-temp-project_1.1 {
        name "Create the temporary RG project that will hold the requirements"
        meta variable-for-rg-base-url = "rgBaseUrl",
             variable-for-locale = "locale",
             variable-for-production = "production",
             variable-for-project-code = "projectCode",
             variable-for-description = "projectDescription",
             variable-for-rg-pipeline-uid = "rgPipelineUid",
             variable-for-model = "model",
             variable-for-effort = "effort",
             create-in-development = "true"
        <- rgBaseUrl, locale, production?, projectDescription, rgPipelineUid, model, effort
        -> projectCode: ext=".txt"
        timeout 60
    }

    select := internal mh.meta-storage {
        name "Read the batch record"
        meta action = "select",
             type = "metaTable",
             keys = "batchKey",
             synthetic = "synthetic",
             output = "batchRecords"
        <- metaTable, batchKey, synthetic
        -> batchRecords: ext=".json"
        timeout 120
        cache on
    }

    paths := mh.asset.rg-batch-paths_1.0 {
        name "Turn the batch record into its list of paths"
        meta variable-for-records = "batchRecords",
             variable-for-paths = "batchPaths"
        <- batchRecords
        -> batchPaths: ext=".txt"
        timeout 60
        cache on
    }

    split := internal mh.batch-line-splitter {
        name "One branch per file of the batch"
        meta number-of-lines-per-task = "1",
             variable-for-splitting = "batchPaths",
             output-is-dynamic = "true",
             output-variable = "sourcePath",
             is-array = "false"
        sequential {
            prompt := mh.asset.rg-req-path-prompt_1.0 {
                name "Read the file and build the CC prompt"
                meta variable-for-source-path = "sourcePath",
                     variable-for-description = "projectDescription",
                     variable-for-prompt = "ccPrompt"
                <- sourcePath, projectDescription
                -> ccPrompt: ext=".txt"
                timeout 60
            }

            cc := mh.asset.call-cc_1.1 {
                name "Ask CC for the file's requirements"
                // the process timeout must be larger than timeout-sec, or MH kills the Task before it can say why
                meta variable-for-prompt = "ccPrompt",
                     variable-for-output = "ccResult",
                     variable-for-model = "model",
                     variable-for-effort = "effort",
                     timeout-sec = "900"
                <- ccPrompt, model, effort
                -> ccResult: ext=".txt"
                timeout 1200
                tries 2
                // model and effort are required inputs (see the variables block), not literals - every run seeds the
                // pair it uses. As inputs their content is hashed into the cache key, so changing the model or
                // effort a run uses correctly misses the old entry; cacheMeta additionally keeps the prompt and
                // timeout apart.
                cache on, cacheMeta
            }

            check := mh.asset.rg-req-check_1.0 {
                name "Check CC's answer and hand it on as one line"
                meta variable-for-source-path = "sourcePath",
                     variable-for-cc-result = "ccResult",
                     variable-for-answer = "reqAnswer"
                <- sourcePath, ccResult
                -> reqAnswer: ext=".txt"
                timeout 60
            }
        }
    }

    gather := internal mh.aggregate {
        name "Collect every file's checked answer"
        // collects by NAME across the whole ExecContext - a branch's variable is invisible at the top level
        meta variables = "reqAnswer",
             type = "text",
             produce-metadata = "false",
             error-control-policy = "fail"
        -> reqAnswers: ext=".txt"
        timeout 300
    }

    first := mh.asset.rg-req-first_1.0 {
        name "Split the answers into requirement #1 and the others"
        meta variable-for-paths = "batchPaths",
             variable-for-answers = "reqAnswers",
             variable-for-first-path = "firstPath",
             variable-for-first-answer = "firstAnswer",
             variable-for-other-reqs = "otherReqs",
             variable-for-has-first = "hasFirstReq"
        <- batchPaths, reqAnswers
        -> firstPath: ext=".txt",
           firstAnswer: ext=".txt",
           otherReqs: ext=".txt",
           hasFirstReq: ext=".txt"
        timeout 120
    }

    insert := internal mh.nop {
        name "Store requirement #1, then every other requirement into one STAGE"
        when hasFirstReq == "true" ? true : false
        <- hasFirstReq
        sequential {
            genesis := internal mhdg-rg.req-store-batch {
                name "Requirement #1 - the project's genesis"
                // the batch store handed a batch of ONE file holding ONE requirement: its genesis alone, no STAGE
                meta variable-for-project-code = "projectCode",
                     variable-for-paths = "firstPath",
                     variable-for-answers = "firstAnswer",
                     variable-for-req-ids = "firstReqIds",
                     variable-for-req-sources = "firstReqSources",
                     variable-for-model = "model",
                     variable-for-effort = "effort"
                <- projectCode, firstPath, firstAnswer, model, effort
                -> firstReqIds: ext=".txt",
                   firstReqSources: ext=".txt"
                timeout 1800
            }

            parent := mh.asset.rg-genesis-snapshot_1.0 {
                name "The genesis snapshot's id - the STAGE's fork point"
                meta variable-for-rg-base-url = "rgBaseUrl",
                     variable-for-project-code = "projectCode",
                     variable-for-snapshot-id = "parentSnapshotId"
                <- rgBaseUrl, projectCode
                -> parentSnapshotId: ext=".txt"
                timeout 120
            }

            open := internal mhdg-rg.open-stage {
                name "Open ONE STAGE from the genesis"
                <- projectCode, parentSnapshotId
                -> stageSnapshotId: type=stage-snapshot-id, ext=".txt",
                   triggerEventId: type=event-id, ext=".txt"
                timeout 300
            }

            reqs := internal mh.batch-line-splitter {
                name "One branch per other requirement"
                meta number-of-lines-per-task = "1",
                     variable-for-splitting = "otherReqs",
                     output-is-dynamic = "true",
                     output-variable = "reqJson",
                     is-array = "false"
                <- otherReqs
                sequential {
                    store := internal mhdg-rg.store-req {
                        name "Store the requirement into the STAGE"
                        meta reqJson = "reqJson",
                             requirementId = "requirementId",
                             storeReqTaskId = "storeReqTaskId"
                        <- projectCode, reqJson: ext=".json", stageSnapshotId
                        -> requirementId: type=requirement-id, ext=".txt",
                           storeReqTaskId: type=store-req-task-id, ext=".txt"
                        timeout 60
                    }
                }
            }

            close := internal mhdg-rg.post-processing {
                name "Commit the STAGE - marked FAILED instead if any Task of this ExecContext failed"
                <- projectCode, stageSnapshotId, triggerEventId
                timeout 60
                tag terminal
            }
        }
    }
}
