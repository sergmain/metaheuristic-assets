// Turn ANY directory into a work queue of batches in meta storage, and register what that queue is.
//
// Reusable by construction - nothing about a particular run appears below:
//   targetDir   comes IN as a source-level input variable, set per run
//   production  comes IN, REQUIRED: 'true' means the production meta store, every other value -
//               'mh.null-value' included - means development, which is the synthetic store
//
// ORDER MATTERS, and it is declaration order that fixes it: a process is chained to the one declared
// before it, so 'register' is guaranteed to run before 'store'. The descriptor therefore exists
// before the first record does. Register last instead and a run that died half-way would leave a
// table full of records that nothing describes - unidentifiable, and unsafe to delete.

source "mh-dir-batcher-1.3" {

    variables {
        <- targetDir
        <- production
    }

    batch := mh.asset.dir-batcher_1.0 {
        name "Split targetDir into batches of files"
        <- targetDir, production
        -> batchRecords: ext=".json",
           metaStorageType: ext=".txt",
           syntheticFlag: ext=".txt",
           tableDesc: ext=".txt",
           tableRecKeyFormat: ext=".txt",
           tableBodyFormat: ext=".txt",
           tableConsumer: ext=".txt"
        timeout 600
    }

    register := internal mh.meta-storage-registry {
        name "Register what this run's meta table is for - before a record exists in it"
        meta meta-table = "metaStorageType",
             production = "production",
             desc = "tableDesc",
             rec-key-format = "tableRecKeyFormat",
             body-format = "tableBodyFormat",
             consumer = "tableConsumer"
        <- metaStorageType, production, tableDesc, tableRecKeyFormat, tableBodyFormat, tableConsumer
        timeout 60
    }

    store := internal mh.meta-storage {
        name "Upsert the batches under the type this run minted, into the table this run selected"
        meta action = "upsert",
             type = "metaStorageType",
             synthetic = "syntheticFlag",
             content = "batchRecords"
        <- metaStorageType, syntheticFlag, batchRecords
        timeout 300
    }
}