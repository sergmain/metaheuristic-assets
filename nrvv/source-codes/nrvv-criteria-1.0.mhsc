// NRVV criteria 1.0 (plan 045, Phase 12, decision 5): the TEST_CASEs of a project's requirement set, written ONCE on
// the project's line for every implementation. A COMMITTED child of the baseline out, holding one ACTIVE TEST_CASE per
// requirement in scope, each verifying its requirement's lineage root (VERIFICATION edge). Started by the Dispatcher
// (NrvvRunService.startCriteria, POST /rest/v1/nrvv/projects/{id}/criteria), never by hand: the run record NRVV_RUN
// #runId - naming the baseline's snapshot (SNAPSHOT_ID) and the baseline it forks from (BASELINE_ID) - exists before
// this ExecContext does, and mhdg-nrvv.finish-run closes it: FINISHED with RESULT_SNAPSHOT_ID = the committed STAGE and
// the line extended (cause CRITERIA), or ERROR.
//
// The criteria half of nrvv-test-author-1.2 (its suites half is nrvv-suite-author): a criterion is language-neutral
// since correction C3, so it is shared by every implementation, and one line lets a change reach every implementation
// as a descendant. Scope: every requirement in scope at the project's first CRITERIA; after it, the affected set since
// the previous CRITERIA baseline - for which mhdg-nrvv.store-test-case writes a changed criterion as a new revision of
// the requirement's TEST_CASE (the TEST_CASE is kept). A requirement whose TEST_CASE resolves at the baseline and is
// not in an affected scope keeps it (REUSE).
//
//   open      internal mhdg-nrvv.open-stage         ONE STAGE forked from the run's baseline, with RG's clone: stageSnapshotId
//   scope     internal mhdg-nrvv.list-scope         the requirements in scope at SNAPSHOT_ID, one reqId per line (the
//                                                   Interface and Environment members of a design are not in it)
//   split, per requirement:
//     read    internal mhdg-rg.read-req             the requirement's text at the STAGE
//     cprompt mh.asset.nrvv-criterion-prompt_1.0    the prompt for ONE pass/fail criterion - the requirement's text
//     ccrit   mh.asset.call-cc_1.1                  CC's criterion
//     ccheck  mh.asset.nrvv-criterion-check_1.0     the criterion, checked, as one line
//     store   internal mhdg-nrvv.store-test-case    the TEST_CASE in the STAGE (REUSE / CREATE / a new revision) and its
//                                                   VERIFICATION edge from the lineage root
//   close     internal mhdg-rg.post-processing      commits the STAGE - marked FAILED instead if any Task failed
//   finish    internal mhdg-nrvv.finish-run         the run record FINISHED or ERROR
//
// Inputs: exactly NrvvRunUtils.criteriaVariables (MH refuses a missing or an undeclared name). Nothing here calls RG
// over HTTP: no rgBaseUrl, no RG_API_AUTH.
//
// Production readiness: not production ready - NRVV requests carry no production mode, so every run is synthetic. It
// becomes production ready when its development run is recorded (plan 045 Phase 12), the acceptance run of plan 045
// Phase 36 has passed through it, and its production copy is in the RG bundle (plan 045 Phase 35).
//
// ORDER is declaration order: each process is chained to the one declared before it; inside a branch the steps run in
// order; close waits for every branch; finish runs last, after failures too (tag terminal).
source "nrvv-criteria-1.0" {

    variables {
        <- production?
        <- runId, projectCode
        // model and effort are ExecContext-level inputs - a property of the RUN, not of this SourceCode. A null model is
        // refused (01.562.124); effort is nullable - null for a model that takes no effort. Omitting either is refused
        // (562.120).
        <- model
        <- effort?
    }

    open := internal mhdg-nrvv.open-stage {
        name "Open ONE STAGE on the run's baseline - every TEST_CASE goes into it"
        <- runId
        -> stageSnapshotId: ext=".txt"
        timeout 300
    }

    scope := internal mhdg-nrvv.list-scope {
        name "The requirements in scope at the named snapshot, one reqId per line"
        <- runId
        -> scope: ext=".txt"
        timeout 60
    }

    split := internal mh.batch-line-splitter {
        name "One branch per requirement"
        meta number-of-lines-per-task = "1",
             variable-for-splitting = "scope",
             output-is-dynamic = "true",
             output-variable = "reqId",
             is-array = "false"
        sequential {
            read := internal mhdg-rg.read-req {
                name "The requirement's text at the STAGE"
                meta reqId = "reqId",
                     requirementContent = "requirementContent",
                     parentId = "parentId",
                     ancestorStack = "ancestorStack"
                <- reqId, stageSnapshotId
                -> requirementContent: type=requirement-content, ext=".txt",
                   parentId: type=parent-id, ext=".txt",
                   ancestorStack: type=ancestor-stack, nullable, ext=".jsonl"
                timeout 60
            }

            cprompt := mh.asset.nrvv-criterion-prompt_1.0 {
                name "Build the prompt for ONE pass/fail criterion - the requirement's text, never code"
                meta variable-for-req-id = "reqId",
                     variable-for-requirement = "requirementContent",
                     variable-for-prompt = "criterionPrompt"
                <- reqId, requirementContent
                -> criterionPrompt: ext=".txt"
                timeout 60
            }

            ccrit := mh.asset.call-cc_1.1 {
                name "Ask CC for the requirement's verification criterion"
                // the process timeout must be larger than timeout-sec, or MH kills the Task before it can say why
                meta variable-for-prompt = "criterionPrompt",
                     variable-for-output = "criterionResult",
                     variable-for-model = "model",
                     variable-for-effort = "effort",
                     timeout-sec = "600"
                <- criterionPrompt, model, effort?
                -> criterionResult: ext=".txt"
                timeout 900
                tries 2
                cache on, cacheMeta
            }

            ccheck := mh.asset.nrvv-criterion-check_1.0 {
                name "Check CC's criterion and hand it on as one line"
                meta variable-for-cc-result = "criterionResult",
                     variable-for-criterion = "criterion"
                <- criterionResult
                -> criterion: ext=".txt"
                timeout 60
            }

            store := internal mhdg-nrvv.store-test-case {
                name "The TEST_CASE in the STAGE and its VERIFICATION edge from the lineage root"
                <- projectCode, stageSnapshotId, reqId, criterion, runId
                -> testCaseReqId: ext=".txt",
                   suiteName: ext=".txt",
                   testCaseCriterion: ext=".txt"
                timeout 120
            }
        }
    }

    close := internal mhdg-rg.post-processing {
        name "Commit the STAGE - marked FAILED instead if any Task of this ExecContext failed"
        <- projectCode, stageSnapshotId
        timeout 60
        tag terminal
    }

    finish := internal mhdg-nrvv.finish-run {
        name "Close the NRVV run record - FINISHED with the CRITERIA snapshot and the line extended, or ERROR"
        <- runId
        timeout 60
        tag terminal
    }
}
