// NRVV expectation-analysis 1.0 (plan 047, Phase 6): CC splits a stakeholder's expectation - the text as written - into
// atomic clauses; each clause becomes a PROPOSED NEED carrying the expectation, its span and its clause kind. For a new
// version of an expectation each clause is also mapped to the agreed NEEDs (UNCHANGED, AMENDS <need>, NEW), and NRVV
// proposes to RETIRE every agreed NEED no clause names. CC never decides: the chain applies the proposals as the
// expectation author's decisions (decideFromAnalysis, Phase 7). Started by the Dispatcher (Execute with an
// expectation, POST /rest/v1/nrvv/expectations/{eid}/analysis, or a new expectation version with start), never by
// hand: the run record NRVV_RUN #runId exists before this ExecContext does and names the expectation, and
// mhdg-nrvv.finish-run closes it.
//
//   expect   internal mhdg-nrvv.read-expectation          the expectation's text and stakeholder; for a new version, the
//                                                           agreed NEEDs at the run's snapshot (the baseline's)
//   eprompt  mh.asset.nrvv-expectation-prompt_1.0          the prompt: the text as numbered pieces with their offsets
//   cce      mh.asset.call-cc_1.2                          CC answers {"clauses": [...]}
//   echeck   mh.asset.nrvv-expectation-check_1.0           the answer checked - spans inside and not overlapping, known
//                                                           kinds, mappings that name agreed NEEDs - in canonical form
//   store    internal mhdg-nrvv.store-expectation-analysis one PROPOSED NEED per clause other than UNCHANGED, one RETIRE
//                                                           proposal per agreed NEED no clause names; checked again
//   finish   internal mhdg-nrvv.finish-run                 the run record FINISHED, or ERROR when any Task failed
//
// No STAGE: the run reads RG and writes NRVV only (decision 3). No checkout, no workspace, no credential.
//
// Inputs: exactly NrvvRunUtils.expectationAnalysisVariables (MH refuses a missing or an undeclared name). `model` is
// declared without '?': NrvvRunService refuses a blank model.
//
// ORDER is declaration order: each process is chained to the one declared before it; finish runs last, after failures
// too (tag terminal). No cache on cce: an analysis asked for again is asked again.

source "nrvv-expectation-analysis-1.0" {

    variables {
        <- production?
        <- runId
        <- model
        <- effort?
    }

    expect := internal mhdg-nrvv.read-expectation {
        name "Read the expectation and, for a new version, the agreed NEEDs at the run's snapshot"
        <- runId
        -> expectation: ext=".json"
        timeout 60
    }

    eprompt := mh.asset.nrvv-expectation-prompt_1.0 {
        name "Build the prompt: the expectation as numbered pieces with their offsets"
        meta variable-for-expectation = "expectation",
             variable-for-prompt = "expectationPrompt"
        <- expectation
        -> expectationPrompt: ext=".txt"
        timeout 60
    }

    cce := mh.asset.call-cc_1.2 {
        name "Ask CC to split the expectation into clauses"
        // the process timeout must be larger than timeout-sec, or MH kills the Task before it can say why
        meta variable-for-prompt = "expectationPrompt",
             variable-for-output = "expectationResult",
             variable-for-model = "model",
             variable-for-effort = "effort",
             timeout-sec = "900"
        <- expectationPrompt, model, effort?
        -> expectationResult: ext=".txt"
        timeout 1200
        tries 2
    }

    echeck := mh.asset.nrvv-expectation-check_1.0 {
        name "Check CC's clauses and hand them on in canonical form"
        meta variable-for-cc-result = "expectationResult",
             variable-for-expectation = "expectation",
             variable-for-clauses = "clauses"
        <- expectationResult, expectation
        -> clauses: ext=".json"
        timeout 60
    }

    store := internal mhdg-nrvv.store-expectation-analysis {
        name "Store one proposed NEED per clause and the RETIRE proposals - checked again by the Dispatcher"
        <- runId, clauses
        timeout 60
    }

    finish := internal mhdg-nrvv.finish-run {
        name "Close the NRVV run record - FINISHED, or ERROR when any Task failed"
        <- runId
        timeout 60
        tag terminal
    }
}
