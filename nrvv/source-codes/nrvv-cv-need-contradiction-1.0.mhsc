// NRVV cv-need-contradiction 1.0 (plan 047, Phase 10): CC reports the pairs of agreed NEEDs that cannot both hold, each with its minimal witness situation.
// One NEEDS_CV run of workflow CONTRADICTION; a CONTRADICTION is hard: run 3 times per gate, the union of the attempts deduplicated by conflict key.
// Started by the Dispatcher (POST /rest/v1/nrvv/projects/{id}/needs-cv with workflow CONTRADICTION, or the chain), never by
// hand: the run record NRVV_RUN #runId exists before this ExecContext does and names the baseline's snapshot, and
// mhdg-nrvv.finish-run closes it.
//
//   agreed   internal mhdg-nrvv.read-agreed-needs              the agreed NEEDs at the run's snapshot, with clause kinds
//   cprompt  mh.asset.nrvv-cv-need-contradiction-prompt_1.0     the prompt: every agreed NEED with its kind
//   cc       mh.asset.call-cc_1.2                             CC answers {"findings": [...]}
//   ccheck   mh.asset.nrvv-cv-need-contradiction-check_1.0      the answer checked - the workflow's kinds, agreed NEEDs as
//                                                              subject and counterpart - a mirrored pair once
//   store    internal mhdg-nrvv.store-findings                 the findings into NRVV_FINDING, each with its conflict key;
//                                                              checked again by the Dispatcher
//   finish   internal mhdg-nrvv.finish-run                     the run record FINISHED, or ERROR when any Task failed
//
// No STAGE: the run reads RG and writes NRVV only. No checkout, no workspace, no credential.
//
// Inputs: exactly NrvvRunUtils.needsCvVariables (MH refuses a missing or an undeclared name). `model` is declared
// without '?': NrvvRunService refuses a blank model (06.004.620).
//
// ORDER is declaration order: each process is chained to the one declared before it; finish runs last, after failures
// too (tag terminal). No cache on cc: each attempt of a group is asked again.

source "nrvv-cv-need-contradiction-1.0" {

    variables {
        <- production?
        <- runId
        <- model
        <- effort?
    }

    agreed := internal mhdg-nrvv.read-agreed-needs {
        name "Read the agreed NEEDs at the run's snapshot - the baseline's when the run started"
        <- runId
        -> agreedNeeds: ext=".json"
        timeout 60
    }

    cprompt := mh.asset.nrvv-cv-need-contradiction-prompt_1.0 {
        name "Build the CONTRADICTION prompt: every agreed NEED with its clause kind"
        meta variable-for-agreed-needs = "agreedNeeds",
             variable-for-prompt = "cvNeedPrompt"
        <- agreedNeeds
        -> cvNeedPrompt: ext=".txt"
        timeout 60
    }

    cc := mh.asset.call-cc_1.2 {
        name "Ask CC for the CONTRADICTION findings on the agreed NEEDs"
        // the process timeout must be larger than timeout-sec, or MH kills the Task before it can say why
        meta variable-for-prompt = "cvNeedPrompt",
             variable-for-output = "cvNeedResult",
             variable-for-model = "model",
             variable-for-effort = "effort",
             timeout-sec = "900"
        <- cvNeedPrompt, model, effort?
        -> cvNeedResult: ext=".txt"
        timeout 1200
        tries 2
    }

    ccheck := mh.asset.nrvv-cv-need-contradiction-check_1.0 {
        name "Check CC's CONTRADICTION findings and hand them on in canonical form"
        meta variable-for-cc-result = "cvNeedResult",
             variable-for-agreed-needs = "agreedNeeds",
             variable-for-findings = "findings"
        <- cvNeedResult, agreedNeeds
        -> findings: ext=".json"
        timeout 60
    }

    store := internal mhdg-nrvv.store-findings {
        name "Store the findings in NRVV_FINDING - checked again by the Dispatcher"
        <- runId, findings
        timeout 60
    }

    finish := internal mhdg-nrvv.finish-run {
        name "Close the NRVV run record - FINISHED, or ERROR when any Task failed"
        <- runId
        timeout 60
        tag terminal
    }
}
