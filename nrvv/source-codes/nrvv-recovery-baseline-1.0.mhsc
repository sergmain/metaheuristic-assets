// NRVV recovery on the baseline 1.0 (plan 045, Phase 11): the requirements of an existing codebase, recovered file by
// file into the RG project an NRVV project with a line owns - ONE STAGE forked from the run's baseline, every file's
// requirements stored from that file's own branch, the STAGE committed once after every branch, a CHILD of the
// baseline that still holds every agreed NEED. Started by the Dispatcher (NrvvRunService.startProjectRecovery on a
// project with a line), never by hand: the run record NRVV_RUN #runId, with the baseline it forks from (BASELINE_ID),
// exists before this ExecContext does, and mhdg-nrvv.finish-run closes it and extends the line (cause RECOVERY).
//
// A new flow name beside nrvv-recovery (a changed flow is a new name): nrvv-recovery-1.3 with ONE change - `open` is
// internal mhdg-nrvv.open-stage, which forks the STAGE inside the Dispatcher from the snapshot of the run's BASELINE_ID
// through RG's RgStageService, with RG's clone of the baseline's ExecContext - the clone mh.asset.rg-req-store-stage's
// writes go into. 1.3's open (mh.asset.rg-open-stage_1.0) opens on an EMPTY project only; nothing reads its
// genesisSnapshotId, which is gone. A project with no line keeps nrvv-recovery until plan 045 Phase 15.
//
// The rest is nrvv-recovery-1.3's - checkout, list, split { prompt, cc, check, ref, store }, close, finish - and so are
// the inputs: exactly NrvvRunUtils.projectRecoveryVariables. rgBaseUrl and the vault entry RG_API_AUTH stay for
// mh.asset.rg-req-store-stage_1.0, which writes into the STAGE through RG's API. The source location and globs come
// from the project's RECOVERY capability. The start refuses a project that already has a FINISHED RECOVERY.
//
// Production readiness: not production ready - NRVV requests carry no production mode, so every run is synthetic. It
// becomes production ready when its development run is recorded (plan 045 Phase 11), the acceptance run of plan 045
// Phase 37 has passed through it, and its production copy is in the RG bundle (plan 045 Phase 35).
//
// ORDER is declaration order: each process is chained to the one declared before it; inside a branch the steps run in
// order; close waits for every branch; finish runs last, after failures too (tag terminal).
source "nrvv-recovery-baseline-1.0" {

    variables {
        <- production?
        <- runId, workspace, source, includeGlobs, excludeGlobs, projectDescription, rgBaseUrl, projectCode
        // model and effort are ExecContext-level inputs - a property of the RUN, not of this SourceCode, and never
        // left to the CLI's own default. A null model is refused (01.562.124); effort is nullable - null for a model
        // that takes no effort (claude-haiku-4-5-20251001). Omitting either is refused (562.120).
        <- model
        <- effort?
    }

    checkout := mh.asset.nrvv-checkout_1.0 {
        name "Check the source repository out at the named ref, under the run workspace"
        meta nrvv-role = "source",
             variable-for-workspace = "workspace",
             variable-for-location = "source",
             variable-for-commit = "sourceCommit",
             variable-for-dir-path = "sourceDirPath"
        <- workspace, source
        -> sourceCommit: ext=".txt",
           sourceDirPath: ext=".txt"
        timeout 1800
    }

    list := mh.asset.nrvv-list-files_1.0 {
        name "List the files to recover - an include glob and no exclude glob"
        meta variable-for-dir-path = "sourceDirPath",
             variable-for-include-globs = "includeGlobs",
             variable-for-exclude-globs = "excludeGlobs",
             variable-for-files = "sourceFiles"
        <- sourceDirPath, includeGlobs, excludeGlobs
        -> sourceFiles: ext=".txt"
        timeout 600
    }

    open := internal mhdg-nrvv.open-stage {
        name "Open ONE STAGE on the run's baseline - every branch stores into it"
        // inside the Dispatcher: forked from the snapshot of the run's own BASELINE_ID, with RG's clone
        <- runId
        -> stageSnapshotId: ext=".txt"
        timeout 300
    }

    split := internal mh.batch-line-splitter {
        name "One branch per file"
        meta number-of-lines-per-task = "1",
             variable-for-splitting = "sourceFiles",
             output-is-dynamic = "true",
             output-variable = "sourcePath",
             is-array = "false"
        sequential {
            prompt := mh.asset.rg-req-path-prompt_1.0 {
                name "Read the file and build the CC prompt"
                meta variable-for-source-path = "sourcePath",
                     variable-for-description = "projectDescription",
                     variable-for-prompt = "ccPrompt"
                <- sourcePath, projectDescription
                -> ccPrompt: ext=".txt"
                timeout 60
            }

            cc := mh.asset.call-cc_1.1 {
                name "Ask CC for the file's requirements"
                // the process timeout must be larger than timeout-sec, or MH kills the Task before it can say why
                meta variable-for-prompt = "ccPrompt",
                     variable-for-output = "ccResult",
                     variable-for-model = "model",
                     variable-for-effort = "effort",
                     timeout-sec = "900"
                <- ccPrompt, model, effort?
                -> ccResult: ext=".txt"
                timeout 1200
                tries 2
                // model and effort are inputs (see the variables block), not literals - every run seeds the pair it
                // uses. As inputs their content is hashed into the cache key, so changing the model or effort a run
                // uses correctly misses the old entry; cacheMeta additionally keeps the prompt and timeout apart.
                cache on, cacheMeta
            }

            check := mh.asset.rg-req-check_1.0 {
                name "Check CC's answer and hand it on as one line"
                // keeps the real file: rg-req-check refuses a source-path that is not an absolute path
                meta variable-for-source-path = "sourcePath",
                     variable-for-cc-result = "ccResult",
                     variable-for-answer = "reqAnswer"
                <- sourcePath, ccResult
                -> reqAnswer: ext=".txt"
                timeout 60
            }

            ref := mh.asset.nrvv-source-ref_1.0 {
                name "Cite the file as repository + revision + repository-relative path, in the answer too"
                // sourceRef = <source.url>@<sourceCommit>:<source.dir>/<sourcePath relative to sourceDirPath>;
                // reqAnswerRef = reqAnswer with its sourcePath replaced by sourceRef. store pairs the two by string
                // equality, and both are written from one computed string. Deterministic: no CC, no network.
                meta variable-for-location = "source",
                     variable-for-commit = "sourceCommit",
                     variable-for-dir-path = "sourceDirPath",
                     variable-for-source-path = "sourcePath",
                     variable-for-answer = "reqAnswer",
                     variable-for-source-ref = "sourceRef",
                     variable-for-ref-answer = "reqAnswerRef"
                <- source, sourceCommit, sourceDirPath, sourcePath, reqAnswer
                -> sourceRef: ext=".txt",
                   reqAnswerRef: ext=".txt"
                timeout 60
            }

            store := mh.asset.rg-req-store-stage_1.0 {
                name "Store this file's requirements into the STAGE"
                // one Task per file, right after ref; the file's requirements written into the open STAGE, each
                // Rationale ending with 'source: <sourceRef>'. No 'tries': a retry after writes that landed would
                // store them twice.
                meta variable-for-rg-base-url = "rgBaseUrl",
                     variable-for-project-code = "projectCode",
                     variable-for-stage-snapshot-id = "stageSnapshotId",
                     variable-for-paths = "sourceRef",
                     variable-for-answers = "reqAnswerRef",
                     variable-for-req-ids = "reqIds",
                     variable-for-req-sources = "reqSources"
                <- rgBaseUrl, projectCode, stageSnapshotId, sourceRef, reqAnswerRef
                -> reqIds: ext=".txt",
                   reqSources: ext=".txt"
                timeout 1800
            }
        }
    }

    close := internal mhdg-rg.post-processing {
        name "Commit the STAGE - marked FAILED instead if any Task of this ExecContext failed"
        <- projectCode, stageSnapshotId
        timeout 60
        tag terminal
    }

    finish := internal mhdg-nrvv.finish-run {
        name "Close the NRVV run record - FINISHED, or ERROR when any Task failed; record the project and the snapshot"
        // reads projectCode and stageSnapshotId only when they were written: it runs after failures too
        <- runId
        timeout 60
        tag terminal
    }
}
