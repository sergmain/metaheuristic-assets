// NRVV definition (plan 043, stage 1 of 2): the NEED records of an RG project in, a COMMITTED definition snapshot out -
// the obligations restating the NEEDs (DECOMPOSED), the design that meets them, the Interface and the Environment
// (DERIVED, each under ONE obligation), the Interface and Environment SECTIONs, one NEED link per obligation x NEED
// code. Started by the Dispatcher (NrvvRunService.startDefinition, POST /rest/v1/nrvv/projects/{id}/definition), never
// by hand: the run record NRVV_RUN #runId exists before this ExecContext does, and mhdg-nrvv.finish-run closes it. A
// FINISHED run starts the realize chain - TEST_AUTHOR on the definition snapshot, then IMPLEMENTATION, then
// VERIFICATION, every one anchored to this run (NrvvRerunService.continueChain).
//
// The proven stage-store shape (rg-requirements DETAILS 12.7, E3), as nrvv-recovery-1.1 uses it:
//   open      mh.asset.rg-open-stage_1.0        RG's mhdg_rg_open_stage WITHOUT a parent: RG runs the project's own
//                                               pipeline as its genesis with no requirement and forks ONE STAGE (with
//                                               its RG clone) from it: stageSnapshotId, genesisSnapshotId. FIRST, so a
//                                               later failure can still close the STAGE (042 savepoint, Phase 10 rule)
//   needs     internal mhdg-nrvv.read-needs     the latest revision of every NEED of the run's RG project
//   dprompt   mh.asset.nrvv-decompose-prompt_1.0   the obligations prompt
//   cdecomp   mh.asset.call-cc_1.1                 CC's obligations
//   dcheck    mh.asset.nrvv-decompose-check_1.0    the obligations, checked: decomposition
//   gprompt   mh.asset.nrvv-design-prompt_1.0      the design / Interface / Environment prompt
//   cdesign   mh.asset.call-cc_1.1                 CC's design
//   gcheck    mh.asset.nrvv-design-check_1.0       the design, checked against the obligations: design
//   store     internal mhdg-nrvv.store-definition  writes the definition into the STAGE through RG's manual-requirement
//                                               path (objection-ready, edition-ready) - writes only: needLinks
//   close     internal mhdg-rg.post-processing   commits the STAGE - marked FAILED instead if any Task failed
//   finish    internal mhdg-nrvv.finish-run      the run record FINISHED (SNAPSHOT_ID = the definition snapshot, NEED
//                                               links written) or ERROR
//
// Inputs: exactly NrvvRunUtils.definitionVariables (MH refuses a missing or an undeclared name). A DEFINITION run is
// refused for an RG project that is not ready or already has a snapshot (genesis only, plan 043 decision 11); a run
// that fails after `open` leaves the empty genesis COMMITTED and the STAGE FAILED, and the RG project is then refused
// for a second definition.
//
// Credential: the vault entry RG_API_AUTH, declared by mh.asset.rg-open-stage_1.0 (rg-requirements bundle - import it
// before this one), is resolved from the management company's Vault, as for nrvv-recovery-1.1. Production readiness:
// nrvv/DETAILS.md, Definition, part 8.
//
// ORDER is declaration order: each process is chained to the one declared before it; close and finish run last,
// after failures too (tag terminal).
source "nrvv-definition-1.0" {

    variables {
        <- production?
        <- runId, projectCode, rgBaseUrl
        // model and effort are ExecContext-level inputs - a property of the RUN, not of this SourceCode, and never
        // left to the CLI's own default. A null model is refused (01.562.124); effort is nullable - null for a model
        // that takes no effort (claude-haiku-4-5-20251001). Omitting either is refused (562.120).
        <- model
        <- effort?
    }

    open := mh.asset.rg-open-stage_1.0 {
        name "Open ONE STAGE on the empty project - the definition is written into it"
        // no 'tries': a second call would find the committed genesis and be refused (689.064)
        meta variable-for-rg-base-url = "rgBaseUrl",
             variable-for-project-code = "projectCode",
             variable-for-model = "model",
             variable-for-effort = "effort",
             variable-for-stage-snapshot-id = "stageSnapshotId",
             variable-for-genesis-snapshot-id = "genesisSnapshotId"
        <- rgBaseUrl, projectCode, model, effort?
        -> stageSnapshotId: ext=".txt",
           genesisSnapshotId: ext=".txt"
        timeout 900
    }

    needs := internal mhdg-nrvv.read-needs {
        name "The latest revision of every NEED of the run's RG project"
        <- runId
        -> needs: ext=".json"
        timeout 60
    }

    dprompt := mh.asset.nrvv-decompose-prompt_1.0 {
        name "Build the prompt that restates the NEEDs as obligations"
        meta variable-for-needs = "needs",
             variable-for-prompt = "decomposePrompt"
        <- needs
        -> decomposePrompt: ext=".txt"
        timeout 60
    }

    cdecomp := mh.asset.call-cc_1.1 {
        name "Ask CC for the obligations"
        // the process timeout must be larger than timeout-sec, or MH kills the Task before it can say why
        meta variable-for-prompt = "decomposePrompt",
             variable-for-output = "decomposeResult",
             variable-for-model = "model",
             variable-for-effort = "effort",
             timeout-sec = "900"
        <- decomposePrompt, model, effort?
        -> decomposeResult: ext=".txt"
        timeout 1200
        tries 2
        cache on, cacheMeta
    }

    dcheck := mh.asset.nrvv-decompose-check_1.0 {
        name "Check the obligations against the NEEDs"
        meta variable-for-cc-result = "decomposeResult",
             variable-for-needs = "needs",
             variable-for-decomposition = "decomposition"
        <- decomposeResult, needs
        -> decomposition: ext=".json"
        timeout 60
    }

    gprompt := mh.asset.nrvv-design-prompt_1.0 {
        name "Build the prompt for the design, the Interface and the Environment"
        meta variable-for-needs = "needs",
             variable-for-decomposition = "decomposition",
             variable-for-prompt = "designPrompt"
        <- needs, decomposition
        -> designPrompt: ext=".txt"
        timeout 60
    }

    cdesign := mh.asset.call-cc_1.1 {
        name "Ask CC for the design, the Interface and the Environment"
        meta variable-for-prompt = "designPrompt",
             variable-for-output = "designResult",
             variable-for-model = "model",
             variable-for-effort = "effort",
             timeout-sec = "900"
        <- designPrompt, model, effort?
        -> designResult: ext=".txt"
        timeout 1200
        tries 2
        cache on, cacheMeta
    }

    gcheck := mh.asset.nrvv-design-check_1.0 {
        name "Check the design against the obligations"
        meta variable-for-cc-result = "designResult",
             variable-for-decomposition = "decomposition",
             variable-for-design = "design"
        <- designResult, decomposition
        -> design: ext=".json"
        timeout 60
    }

    store := internal mhdg-nrvv.store-definition {
        name "Write the definition into the STAGE - obligations, design, Interface, Environment, the two sections"
        <- runId, stageSnapshotId, needs, decomposition, design
        -> needLinks: ext=".json"
        timeout 1800
    }

    close := internal mhdg-rg.post-processing {
        name "Commit the STAGE - marked FAILED instead if any Task of this ExecContext failed"
        <- projectCode, stageSnapshotId
        timeout 60
        tag terminal
    }

    finish := internal mhdg-nrvv.finish-run {
        name "Close the NRVV run record - FINISHED with the definition snapshot and the NEED links, or ERROR"
        // reads stageSnapshotId and needLinks only when they were written: it runs after failures too
        <- runId
        timeout 60
        tag terminal
    }
}
