// NRVV definition-top-level 1.0 (plan 050, decision 3): the top-level requirement set, defined under the NEED
// interpretation, BEFORE any design exists - one session per derivation NEED for its top-level requirements (read through
// the interpretation items governing it, each clause quoting the NEED words it rests on, at most TOP_LEVEL_PER_NEED_MAX
// of them citing the subject), one session for the Interface and the Environment. No design part: the AFTER_DEFINITION
// gate judges this set as a whole, and a DESIGN run (nrvv-design) writes the design per top-level requirement after it
// passes. Every part is written into ONE STAGE; the RG writes are serialized per STAGE, the CC sessions run in parallel.
// One DEFINITION run per project. Started by the Dispatcher (the chain, after the interpretation gate passes), never by
// hand: the run record NRVV_RUN #runId exists before this ExecContext does and names its baseline, and
// mhdg-nrvv.finish-run closes it.
//
// The parts are nrvv-definition-interpreted-1.0's SUBJECTS / TOP_LEVEL and BOUNDARY parts, unchanged:
//
//   open       internal mhdg-nrvv.open-stage              ONE STAGE on the run's baseline: stageSnapshotId
//   subjects   internal mhdg-nrvv.read-definition-input   SUBJECTS: definitionInput, subjects (one per line)
//   tops       internal mh.batch-line-splitter            one branch per subject, in parallel
//     tprompt / tcc / tcheck / tstore (store-definition-part TOP_LEVEL, meta subject = the line)
//   boundaryIn internal mhdg-nrvv.read-definition-input   BOUNDARY: boundaryInput - the top-level requirements written
//   bprompt / bcc / bcheck / bstore (store-definition-part BOUNDARY)
//   close      internal mhdg-rg.post-processing           commits the STAGE - marked FAILED instead if any Task failed
//   finish     internal mhdg-nrvv.finish-run              the run FINISHED with its snapshot, the line extended
//
// A check that refuses CC's answer writes {"refused": "<rule>"}: its part writes ANSWER_REFUSED findings and nothing to
// RG, and the run goes on - the loop repairs the part later.
//
// Inputs: exactly NrvvRunUtils.definitionBaselineVariables (MH refuses a missing or an undeclared name).
//
// ORDER is declaration order; inside a branch the steps run in order; close and finish run last, after failures too
// (tag terminal). No cache on cc.

source "nrvv-definition-top-level-1.0" {

    variables {
        <- production?
        <- runId, projectCode
        <- model
        <- effort?
    }

    open := internal mhdg-nrvv.open-stage {
        name "Open ONE STAGE on the run's baseline"
        <- runId
        -> stageSnapshotId: ext=".txt"
        timeout 300
    }

    subjects := internal mhdg-nrvv.read-definition-input {
        name "Read the subjects - the derivation NEEDs - with the items governing each"
        meta part = "SUBJECTS"
        <- runId, stageSnapshotId
        -> definitionInput: ext=".json",
           subjects: ext=".txt"
        timeout 120
    }

    tops := internal mh.batch-line-splitter {
        name "One branch per subject"
        meta number-of-lines-per-task = "1",
             variable-for-splitting = "subjects",
             output-is-dynamic = "true",
             output-variable = "subject",
             is-array = "false"
        <- subjects
        sequential {
            tprompt := mh.asset.nrvv-define-top-prompt_1.0 {
                name "Build the prompt of the subject's top-level requirements"
                meta variable-for-definition-input = "definitionInput",
                     variable-for-subject = "subject",
                     variable-for-prompt = "topPrompt"
                <- definitionInput, subject
                -> topPrompt: ext=".txt"
                timeout 60
            }

            tcc := mh.asset.call-cc_1.2 {
                name "Ask CC for the subject's top-level requirements"
                // the process timeout must be larger than timeout-sec, or MH kills the Task before it can say why
                meta variable-for-prompt = "topPrompt",
                     variable-for-output = "topResult",
                     variable-for-model = "model",
                     variable-for-effort = "effort",
                     timeout-sec = "900"
                <- topPrompt, model, effort?
                -> topResult: ext=".txt"
                timeout 1200
                tries 2
            }

            tcheck := mh.asset.nrvv-define-top-check_1.0 {
                name "Check the requirements - the evidence rules and the cap; a broken rule is written as a refusal"
                meta variable-for-cc-result = "topResult",
                     variable-for-definition-input = "definitionInput",
                     variable-for-subject = "subject",
                     variable-for-answer = "topAnswer"
                <- topResult, definitionInput, subject
                -> topAnswer: ext=".json"
                timeout 60
            }

            tstore := internal mhdg-nrvv.store-definition-part {
                name "Write the subject's top-level requirements into the STAGE - checked again by the Dispatcher"
                meta part = "TOP_LEVEL",
                     answer = "topAnswer",
                     subject = "subject"
                <- runId, stageSnapshotId, topAnswer, subject
                timeout 1800
            }
        }
    }

    boundaryIn := internal mhdg-nrvv.read-definition-input {
        name "Read the top-level requirements written, and the ASSUMPTION and OPEN_CHOICE items"
        meta part = "BOUNDARY"
        <- runId, stageSnapshotId
        -> boundaryInput: ext=".json"
        timeout 120
    }

    bprompt := mh.asset.nrvv-boundary-prompt_1.0 {
        name "Build the prompt of the Interface and the Environment"
        meta variable-for-boundary-input = "boundaryInput",
             variable-for-prompt = "boundaryPrompt"
        <- boundaryInput
        -> boundaryPrompt: ext=".txt"
        timeout 60
    }

    bcc := mh.asset.call-cc_1.2 {
        name "Ask CC for the Interface and the Environment"
        meta variable-for-prompt = "boundaryPrompt",
             variable-for-output = "boundaryResult",
             variable-for-model = "model",
             variable-for-effort = "effort",
             timeout-sec = "900"
        <- boundaryPrompt, model, effort?
        -> boundaryResult: ext=".txt"
        timeout 1200
        tries 2
    }

    bcheck := mh.asset.nrvv-boundary-check_1.0 {
        name "Check the Interface and the Environment; a broken rule is written as a refusal"
        meta variable-for-cc-result = "boundaryResult",
             variable-for-boundary-input = "boundaryInput",
             variable-for-answer = "boundaryAnswer"
        <- boundaryResult, boundaryInput
        -> boundaryAnswer: ext=".json"
        timeout 60
    }

    bstore := internal mhdg-nrvv.store-definition-part {
        name "Write the Interface and the Environment into the STAGE"
        meta part = "BOUNDARY",
             answer = "boundaryAnswer"
        <- runId, stageSnapshotId, boundaryAnswer
        timeout 1800
    }

    close := internal mhdg-rg.post-processing {
        name "Commit the STAGE - marked FAILED instead if any Task failed"
        <- projectCode, stageSnapshotId
        timeout 60
        tag terminal
    }

    finish := internal mhdg-nrvv.finish-run {
        name "Close the NRVV run record - FINISHED with its snapshot, or ERROR when any Task failed"
        <- runId
        timeout 60
        tag terminal
    }
}
