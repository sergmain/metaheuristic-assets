// NRVV recovery (plan 042, decision 11): the requirements of an existing codebase, recovered file by file into a NEW
// RG project - ONE STAGE opened on the still-EMPTY project, every file's requirements stored from that file's own
// branch, the STAGE committed once after every branch. Started by the Dispatcher (NrvvRunService.startRecovery), never
// by hand: the run record NRVV_RUN #runId exists before this ExecContext does, and mhdg-nrvv.finish-run closes it.
//
// mh-rg-requirements-from-batch-stage-store-1.0's graph, gathering its files itself instead of reading a batch from
// meta storage - no meta storage and no batches (plan 042, red lines):
//   checkout  mh.asset.nrvv-checkout_1.0        the source repository at the ref the request named, under the run
//                                               workspace (decision 8): sourceCommit, sourceDirPath
//   list      mh.asset.nrvv-list-files_1.0      the files under sourceDirPath matching an include glob and no exclude
//                                               glob, one absolute path per line, sorted: sourceFiles
//   mkproject, open, split { prompt, cc, check, store }, close   as in stage-store-1.0, split over sourceFiles
//   finish    internal mhdg-nrvv.finish-run     the run record FINISHED or ERROR; RECOVERY also records projectCode
//                                               as INFO_BANK and the committed STAGE as SNAPSHOT_ID
//
// The same SourceCode serves one file and a whole repository. Inputs: exactly NrvvRunUtils.recoveryVariables (MH
// refuses a missing or an undeclared name). Output projectCode at ExecContext level; reqIds / reqSources per branch.
//
// Credential: the vault entry RG_API_AUTH, declared by mh.asset.rg-temp-project_1.1, mh.asset.rg-open-stage_1.0 and
// mh.asset.rg-req-store-stage_1.0 - the run's company must hold it. The source repository is read anonymously
// (decision 20). Production readiness: nrvv/DETAILS.md, Recovery, part 8.
//
// ORDER is declaration order: each process is chained to the one declared before it; inside a branch the steps run in
// order; close waits for every branch; finish runs last, after failures too (tag terminal).
source "nrvv-recovery-1.0" {

    variables {
        <- production?
        <- runId, workspace, source, includeGlobs, excludeGlobs, projectDescription, locale, rgBaseUrl, rgPipelineUid
        // model and effort are ExecContext-level inputs - a property of the RUN, not of this SourceCode, and never
        // left to the CLI's own default. A null model is refused (01.562.124); effort is nullable - null for a model
        // that takes no effort (claude-haiku-4-5-20251001). Omitting either is refused (562.120).
        <- model
        <- effort?
        -> projectCode
    }

    checkout := mh.asset.nrvv-checkout_1.0 {
        name "Check the source repository out at the named ref, under the run workspace"
        meta nrvv-role = "source",
             variable-for-workspace = "workspace",
             variable-for-location = "source",
             variable-for-commit = "sourceCommit",
             variable-for-dir-path = "sourceDirPath"
        <- workspace, source
        -> sourceCommit: ext=".txt",
           sourceDirPath: ext=".txt"
        timeout 1800
    }

    list := mh.asset.nrvv-list-files_1.0 {
        name "List the files to recover - an include glob and no exclude glob"
        meta variable-for-dir-path = "sourceDirPath",
             variable-for-include-globs = "includeGlobs",
             variable-for-exclude-globs = "excludeGlobs",
             variable-for-files = "sourceFiles"
        <- sourceDirPath, includeGlobs, excludeGlobs
        -> sourceFiles: ext=".txt"
        timeout 600
    }

    mkproject := mh.asset.rg-temp-project_1.1 {
        name "Create the temporary RG project that will hold the requirements"
        meta variable-for-rg-base-url = "rgBaseUrl",
             variable-for-locale = "locale",
             variable-for-production = "production",
             variable-for-project-code = "projectCode",
             variable-for-description = "projectDescription",
             variable-for-rg-pipeline-uid = "rgPipelineUid",
             variable-for-model = "model",
             variable-for-effort = "effort",
             create-in-development = "true"
        <- rgBaseUrl, locale, production?, projectDescription, rgPipelineUid, model, effort?
        -> projectCode: ext=".txt"
        timeout 60
    }

    open := mh.asset.rg-open-stage_1.0 {
        name "Open ONE STAGE on the empty project - every branch stores into it"
        // no 'tries': a second call would find the committed genesis and be refused (689.064)
        meta variable-for-rg-base-url = "rgBaseUrl",
             variable-for-project-code = "projectCode",
             variable-for-model = "model",
             variable-for-effort = "effort",
             variable-for-stage-snapshot-id = "stageSnapshotId",
             variable-for-genesis-snapshot-id = "genesisSnapshotId"
        <- rgBaseUrl, projectCode, model, effort?
        -> stageSnapshotId: ext=".txt",
           genesisSnapshotId: ext=".txt"
        timeout 900
    }

    split := internal mh.batch-line-splitter {
        name "One branch per file"
        meta number-of-lines-per-task = "1",
             variable-for-splitting = "sourceFiles",
             output-is-dynamic = "true",
             output-variable = "sourcePath",
             is-array = "false"
        sequential {
            prompt := mh.asset.rg-req-path-prompt_1.0 {
                name "Read the file and build the CC prompt"
                meta variable-for-source-path = "sourcePath",
                     variable-for-description = "projectDescription",
                     variable-for-prompt = "ccPrompt"
                <- sourcePath, projectDescription
                -> ccPrompt: ext=".txt"
                timeout 60
            }

            cc := mh.asset.call-cc_1.1 {
                name "Ask CC for the file's requirements"
                // the process timeout must be larger than timeout-sec, or MH kills the Task before it can say why
                meta variable-for-prompt = "ccPrompt",
                     variable-for-output = "ccResult",
                     variable-for-model = "model",
                     variable-for-effort = "effort",
                     timeout-sec = "900"
                <- ccPrompt, model, effort?
                -> ccResult: ext=".txt"
                timeout 1200
                tries 2
                // model and effort are inputs (see the variables block), not literals - every run seeds the pair it
                // uses. As inputs their content is hashed into the cache key, so changing the model or effort a run
                // uses correctly misses the old entry; cacheMeta additionally keeps the prompt and timeout apart.
                cache on, cacheMeta
            }

            check := mh.asset.rg-req-check_1.0 {
                name "Check CC's answer and hand it on as one line"
                meta variable-for-source-path = "sourcePath",
                     variable-for-cc-result = "ccResult",
                     variable-for-answer = "reqAnswer"
                <- sourcePath, ccResult
                -> reqAnswer: ext=".txt"
                timeout 60
            }

            store := mh.asset.rg-req-store-stage_1.0 {
                name "Store this file's requirements into the STAGE"
                // one Task per file, right after check; the file's requirements written into the open STAGE. No
                // 'tries': a retry after writes that landed would store them twice.
                meta variable-for-rg-base-url = "rgBaseUrl",
                     variable-for-project-code = "projectCode",
                     variable-for-stage-snapshot-id = "stageSnapshotId",
                     variable-for-paths = "sourcePath",
                     variable-for-answers = "reqAnswer",
                     variable-for-req-ids = "reqIds",
                     variable-for-req-sources = "reqSources"
                <- rgBaseUrl, projectCode, stageSnapshotId, sourcePath, reqAnswer
                -> reqIds: ext=".txt",
                   reqSources: ext=".txt"
                timeout 1800
            }
        }
    }

    close := internal mhdg-rg.post-processing {
        name "Commit the STAGE - marked FAILED instead if any Task of this ExecContext failed"
        <- projectCode, stageSnapshotId
        timeout 60
        tag terminal
    }

    finish := internal mhdg-nrvv.finish-run {
        name "Close the NRVV run record - FINISHED, or ERROR when any Task failed; record the project and the snapshot"
        // reads projectCode and stageSnapshotId only when they were written: it runs after failures too
        <- runId
        timeout 60
        tag terminal
    }
}
