// NRVV cv-need-feasibility 1.0 (plan 047, Phase 11): can the agreed NEEDs be implemented at all? CC answers ONE
// verdict: INFEASIBLE (the minimal set of NEEDs that cannot hold together - a hard finding, NRVV declines),
// UNDERDETERMINED (a witness design and the choices the NEEDs leave open - a soft finding) or DETERMINED (a witness
// design - no finding). One NEEDS_CV run of workflow FEASIBILITY; run 3 times per gate (decision 13). Started by the
// Dispatcher (POST /rest/v1/nrvv/projects/{id}/needs-cv with workflow FEASIBILITY, or the chain), never by hand: the
// run record NRVV_RUN #runId exists before this ExecContext does and names the baseline's snapshot, and
// mhdg-nrvv.finish-run closes it.
//
//   agreed   internal mhdg-nrvv.read-agreed-needs              the agreed NEEDs at the run's snapshot, with clause kinds
//   cprompt  mh.asset.nrvv-cv-need-feasibility-prompt_1.0      the prompt: every agreed NEED with its kind
//   cc       mh.asset.call-cc_1.2                             CC answers {"verdict": ...}
//   ccheck   mh.asset.nrvv-cv-need-feasibility-check_1.0       the verdict checked, in canonical form (variable findings)
//   store    internal mhdg-nrvv.store-findings                 INFEASIBLE / UNDERDETERMINED into NRVV_FINDING, DETERMINED
//                                                              none; checked again by the Dispatcher
//   finish   internal mhdg-nrvv.finish-run                     the run record FINISHED, or ERROR when any Task failed
//
// No STAGE: the run reads RG and writes NRVV only. No checkout, no workspace, no credential.
//
// Inputs: exactly NrvvRunUtils.needsCvVariables (MH refuses a missing or an undeclared name). `model` is declared
// without '?': NrvvRunService refuses a blank model (06.004.620).
//
// ORDER is declaration order: each process is chained to the one declared before it; finish runs last, after failures
// too (tag terminal). No cache on cc: each attempt of a group is asked again.

source "nrvv-cv-need-feasibility-1.0" {

    variables {
        <- production?
        <- runId
        <- model
        <- effort?
    }

    agreed := internal mhdg-nrvv.read-agreed-needs {
        name "Read the agreed NEEDs at the run's snapshot - the baseline's when the run started"
        <- runId
        -> agreedNeeds: ext=".json"
        timeout 60
    }

    cprompt := mh.asset.nrvv-cv-need-feasibility-prompt_1.0 {
        name "Build the FEASIBILITY prompt: every agreed NEED with its clause kind"
        meta variable-for-agreed-needs = "agreedNeeds",
             variable-for-prompt = "cvNeedPrompt"
        <- agreedNeeds
        -> cvNeedPrompt: ext=".txt"
        timeout 60
    }

    cc := mh.asset.call-cc_1.2 {
        name "Ask CC for the FEASIBILITY verdict on the agreed NEEDs"
        // the process timeout must be larger than timeout-sec, or MH kills the Task before it can say why
        meta variable-for-prompt = "cvNeedPrompt",
             variable-for-output = "cvNeedResult",
             variable-for-model = "model",
             variable-for-effort = "effort",
             timeout-sec = "900"
        <- cvNeedPrompt, model, effort?
        -> cvNeedResult: ext=".txt"
        timeout 1200
        tries 2
    }

    ccheck := mh.asset.nrvv-cv-need-feasibility-check_1.0 {
        name "Check CC's FEASIBILITY verdict and hand it on in canonical form"
        meta variable-for-cc-result = "cvNeedResult",
             variable-for-agreed-needs = "agreedNeeds",
             variable-for-findings = "findings"
        <- cvNeedResult, agreedNeeds
        -> findings: ext=".json"
        timeout 60
    }

    store := internal mhdg-nrvv.store-findings {
        name "Store the verdict's finding in NRVV_FINDING - checked again by the Dispatcher"
        <- runId, findings
        timeout 60
    }

    finish := internal mhdg-nrvv.finish-run {
        name "Close the NRVV run record - FINISHED, or ERROR when any Task failed"
        <- runId
        timeout 60
        tag terminal
    }
}
