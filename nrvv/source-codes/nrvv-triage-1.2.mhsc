// plan 050 Phase 17 (2026-10-25): nrvv-triage-1.2 - the graph of nrvv-triage-1.0 unchanged, a version above its production copy
// nrvv-triage-1.1 so NRVV runs this development flow and its API twin (the git-sourced mh.asset.call-cc-api,
// with the API-path fixes); the production copy of plan 050 Phase 19 ships above it.
// NRVV triage 1.0 (plan 047, Phase 23, decision 17): after a VERIFICATION with FAIL or INCONCLUSIVE verdicts, ONE CC
// session classes every test that did not pass - CODE, TEST, ENVIRONMENT or REQUIREMENT - with a one-line reason; the
// chain then repairs by class (NrvvTriageService). Started by the Dispatcher's chain after a VERIFICATION of a repair
// loop, never by hand: the run record NRVV_RUN #runId (BASE_RUN_ID = the VERIFICATION it triages) exists before this
// ExecContext does, and mhdg-nrvv.finish-run closes it.
//
//   suiteCheckout  mh.asset.nrvv-checkout_1.0          the test-suite repository at its branch - the tests' files
//   tprompt        mh.asset.nrvv-triage-prompt_1.0     the prompt: the tests that did not pass with their messages,
//                                                       their files, their suites' requirements and criteria, the
//                                                       requirements in force, tests/nrvv_env/ when present
//   cc             mh.asset.call-cc_1.2                CC answers {"triage": [...]}
//   tcheck         mh.asset.nrvv-triage-check_1.0      every listed test answered once, a known class, a one-line
//                                                       reason; the canonical triage (variable triage)
//   store          internal mhdg-nrvv.store-triage     the triage checked again against the VERIFICATION's results and
//                                                       recorded on the run (NrvvRunParams.triage)
//   finish         internal mhdg-nrvv.finish-run       the run record FINISHED, or ERROR when any Task failed
//
// No STAGE, no RG write, no push: the test-suite repository is cloned anonymously and read only.
//
// Inputs: exactly NrvvRunUtils.triageVariables (MH refuses a missing or an undeclared name). `model` is declared without
// '?': NrvvRunService refuses a TRIAGE without a model (06.004.070). `triageContext` is the JSON NrvvTriageService
// builds from the VERIFICATION's NRVV_RUN_RESULT rows.
//
// ORDER is declaration order: each process is chained to the one declared before it; finish runs last, after failures
// too (tag terminal). No cache on cc.

source "nrvv-triage-1.2" {

    variables {
        <- production?
        <- runId, workspace, testSuite, triageContext
        <- model
        <- effort?
    }

    suiteCheckout := mh.asset.nrvv-checkout_1.0 {
        name "Check the test-suite repository out at its branch - the files of the tests to triage"
        meta nrvv-role = "test-suite",
             variable-for-workspace = "workspace",
             variable-for-location = "testSuite",
             variable-for-commit = "testSuiteBase",
             variable-for-dir-path = "testSuiteDirPath"
        <- workspace, testSuite
        -> testSuiteBase: ext=".txt",
           testSuiteDirPath: ext=".txt"
        timeout 1800
    }

    tprompt := mh.asset.nrvv-triage-prompt_1.0 {
        name "Build the TRIAGE prompt: the tests that did not pass, their files, suites and requirements"
        meta variable-for-triage-context = "triageContext",
             variable-for-test-suite-dir = "testSuiteDirPath",
             variable-for-prompt = "triagePrompt"
        <- triageContext, testSuiteDirPath
        -> triagePrompt: ext=".txt"
        timeout 60
    }

    cc := mh.asset.call-cc_1.2 {
        name "Ask CC to class every test that did not pass"
        // the process timeout must be larger than timeout-sec, or MH kills the Task before it can say why
        meta variable-for-prompt = "triagePrompt",
             variable-for-output = "triageResult",
             variable-for-model = "model",
             variable-for-effort = "effort",
             timeout-sec = "900"
        <- triagePrompt, model, effort?
        -> triageResult: ext=".txt"
        timeout 1200
        tries 2
    }

    tcheck := mh.asset.nrvv-triage-check_1.0 {
        name "Check CC's triage and hand it on in canonical form"
        meta variable-for-cc-result = "triageResult",
             variable-for-triage-context = "triageContext",
             variable-for-triage = "triage"
        <- triageResult, triageContext
        -> triage: ext=".json"
        timeout 60
    }

    store := internal mhdg-nrvv.store-triage {
        name "Record the triage on the run - checked again by the Dispatcher against the VERIFICATION"
        <- runId, triage
        timeout 60
    }

    finish := internal mhdg-nrvv.finish-run {
        name "Close the NRVV run record - FINISHED, or ERROR when any Task failed"
        <- runId
        timeout 60
        tag terminal
    }
}
