// NRVV suite-author 1.1 (plan 045, Phase 12): one implementation's tests - one pytest suite per TEST_CASE of the CRITERIA
// snapshot the run names - written into the implementation's test-suite repository, committed and pushed. Nothing is
// written to RG: the TEST_CASEs were written once on the project line by the CRITERIA run (nrvv-criteria), and this run
// reads them. Started by the Dispatcher (a TEST_AUTHOR run - by hand on a CRITERIA snapshot, or by the chain after a
// CRITERIA run, one per implementation it names), never by hand: the run record NRVV_RUN #runId exists before this
// ExecContext does, and mhdg-nrvv.finish-run closes it - FINISHED with the pushed commit (TEST_SUITE_COMMIT) and no
// result snapshot, or ERROR. IMPLEMENTATION then runs on the same CRITERIA snapshot.
//
// The suites half of nrvv-test-author-1.2 (its criteria half is nrvv-criteria): no STAGE is opened or closed, and per
// requirement `read` is internal mhdg-nrvv.read-test-case - the requirement's text and the TEST_CASE CRITERIA wrote for it
// (testCaseReqId, suiteName, the governed criterion) at the named snapshot. A requirement in scope with no TEST_CASE there
// fails its branch ("run CRITERIA first") and so the run.
//
//   checkout  mh.asset.nrvv-checkout_1.0         the test-suite repository at its branch, under the run workspace
//   scope     internal mhdg-nrvv.list-scope      the requirements in scope at the named snapshot; the snapshot's design,
//                                                if any; writeEnv
//   envWrapper / envGate (only when writeEnv - a design and the whole scope):
//     eprompt mh.asset.nrvv-env-prompt_1.0       the prompt for the simulated environment nrvv_env
//     cenv    mh.asset.call-cc_1.1               CC's environment
//     ewrite  mh.asset.nrvv-env-write_1.0        tests/nrvv_env/ written into the checkout
//   split, per requirement:
//     read    internal mhdg-nrvv.read-test-case  the requirement's text and its TEST_CASE at the named snapshot
//     tprompt mh.asset.nrvv-test-prompt_1.0      the prompt for the suite's pytest file
//     ctest   mh.asset.call-cc_1.1               CC's tests
//     twrite  mh.asset.nrvv-test-write_1.0       the suite's two files written into the checkout
//   noFailure internal mhdg-nrvv.no-failed-task  stop when any Task failed - nothing is pushed then
//   message   internal mh.string-as-variable     the commit message
//   commit    mh.asset.nrvv-commit-push_1.0      commit every suite and push it: testSuiteCommit
//   finish    internal mhdg-nrvv.finish-run      the run record FINISHED (the commit) or ERROR
//
// Inputs: exactly NrvvRunUtils.testAuthorVariables (MH refuses a missing or an undeclared name). parentSnapshotId stays
// declared - the run's input contract still carries it - although nothing here reads it any more. projectCode, nrvvCode
// and snapshotId are read by the Functions through the run record.
//
// ORDER is declaration order: each process is chained to the one declared before it; inside a branch the steps run in
// order; finish runs last, after failures too (tag terminal).
//
// 1.1 against 1.0 (plan 045, Phase 19): the environment is gated on list-scope's writeEnv (a design AND the whole scope),
// not on hasDesign. A scoped run - a re-run, which re-authors only the affected suites - keeps the nrvv_env its checkout
// holds: 1.0 wrote a new one from the design items inside the scope, and every suite outside the scope, still importing
// it, failed (plan 045 Phase 19 development run, VERIFICATION #86). Needs a Dispatcher whose list-scope writes writeEnv.
source "nrvv-suite-author-1.1" {

    variables {
        <- production?
        <- runId, workspace, projectCode, nrvvCode, snapshotId, parentSnapshotId, testSuite, target
        <- model
        <- effort?
        inline nrvvSuiteAuthor {
            commitMessage = "nrvv suite-author: one suite per TEST_CASE"
        }
    }

    checkout := mh.asset.nrvv-checkout_1.0 {
        name "Check the test-suite repository out at its branch, under the run workspace"
        meta nrvv-role = "test-suite",
             variable-for-workspace = "workspace",
             variable-for-location = "testSuite",
             variable-for-commit = "testSuiteBase",
             variable-for-dir-path = "testSuiteDirPath"
        <- workspace, testSuite
        -> testSuiteBase: ext=".txt",
           testSuiteDirPath: ext=".txt"
        timeout 1800
    }

    scope := internal mhdg-nrvv.list-scope {
        name "The requirements in scope at the named snapshot, one reqId per line; the design, when there is one"
        <- runId
        -> scope: ext=".txt",
           design: ext=".json",
           hasDesign: type=boolean, ext=".txt",
           writeEnv: type=boolean, ext=".txt"
        timeout 60
    }

    envWrapper := internal mh.nop {
        name "The simulated environment nrvv_env - its gate runs only for a design and the whole scope"
        sequential {
            envGate := internal mh.nop {
                name "Gate: only when the snapshot has a design and the run's scope is everything"
                when writeEnv ? true : false
                <- writeEnv
                sequential {
                    eprompt := mh.asset.nrvv-env-prompt_1.0 {
                        name "Build the prompt for the simulated environment nrvv_env - the Interface and the Environment"
                        meta variable-for-design = "design",
                             variable-for-prompt = "envPrompt"
                        <- design
                        -> envPrompt: ext=".txt"
                        timeout 60
                    }

                    cenv := mh.asset.call-cc_1.1 {
                        name "Ask CC for the simulated environment"
                        // the process timeout must be larger than timeout-sec, or MH kills the Task before it can say why
                        meta variable-for-prompt = "envPrompt",
                             variable-for-output = "envResult",
                             variable-for-model = "model",
                             variable-for-effort = "effort",
                             timeout-sec = "900"
                        <- envPrompt, model, effort?
                        -> envResult: ext=".txt"
                        timeout 1200
                        tries 2
                        cache on, cacheMeta
                    }

                    ewrite := mh.asset.nrvv-env-write_1.0 {
                        name "Check CC's environment and write it as tests/nrvv_env/ of the test-suite checkout"
                        meta variable-for-workspace = "workspace",
                             variable-for-location = "testSuite",
                             variable-for-cc-result = "envResult",
                             variable-for-files = "envFiles"
                        <- workspace, testSuite, envResult
                        -> envFiles: ext=".json"
                        timeout 60
                    }
                }
            }
        }
    }

    split := internal mh.batch-line-splitter {
        name "One branch per requirement"
        meta number-of-lines-per-task = "1",
             variable-for-splitting = "scope",
             output-is-dynamic = "true",
             output-variable = "reqId",
             is-array = "false"
        sequential {
            read := internal mhdg-nrvv.read-test-case {
                name "The requirement's text and its TEST_CASE at the named snapshot - run CRITERIA first when it has none"
                <- runId, reqId
                -> requirementContent: ext=".txt",
                   testCaseReqId: ext=".txt",
                   suiteName: ext=".txt",
                   testCaseCriterion: ext=".txt"
                timeout 60
            }

            tprompt := mh.asset.nrvv-test-prompt_1.0 {
                name "Build the prompt for the suite's pytest file - requirement, governed criterion and the design, never code"
                meta variable-for-req-id = "reqId",
                     variable-for-requirement = "requirementContent",
                     variable-for-criterion = "testCaseCriterion",
                     variable-for-suite-name = "suiteName",
                     variable-for-test-case-req-id = "testCaseReqId",
                     variable-for-design = "design",
                     variable-for-env-dir = "testSuiteDirPath",
                     variable-for-prompt = "testPrompt"
                <- reqId, requirementContent, testCaseCriterion, suiteName, testCaseReqId, design, testSuiteDirPath
                -> testPrompt: ext=".txt"
                timeout 60
            }

            ctest := mh.asset.call-cc_1.1 {
                name "Ask CC for the tests of the TEST_CASE"
                meta variable-for-prompt = "testPrompt",
                     variable-for-output = "testResult",
                     variable-for-model = "model",
                     variable-for-effort = "effort",
                     timeout-sec = "900"
                <- testPrompt, model, effort?
                -> testResult: ext=".txt"
                timeout 1200
                tries 2
                cache on, cacheMeta
            }

            twrite := mh.asset.nrvv-test-write_1.0 {
                name "Check CC's tests and write the suite's two files into the test-suite checkout"
                meta variable-for-workspace = "workspace",
                     variable-for-location = "testSuite",
                     variable-for-suite-name = "suiteName",
                     variable-for-cc-result = "testResult",
                     variable-for-suite-files = "suiteFiles"
                <- workspace, testSuite, suiteName, testResult
                -> suiteFiles: ext=".json"
                timeout 60
            }
        }
    }

    noFailure := internal mhdg-nrvv.no-failed-task {
        name "Stop when any Task failed - nothing is pushed then"
        timeout 60
    }

    message := internal mh.string-as-variable {
        name "The commit message, lifted out of inline"
        meta mapping = "mapping: [{key: nrvvSuiteAuthor, name: commitMessage, output: commitMessage}]"
        -> commitMessage: ext=".txt"
        timeout 60
    }

    commit := mh.asset.nrvv-commit-push_1.0 {
        name "Commit every suite and push it to the test-suite branch"
        meta nrvv-role = "test-suite",
             variable-for-workspace = "workspace",
             variable-for-location = "testSuite",
             variable-for-commit-message = "commitMessage",
             variable-for-commit = "testSuiteCommit"
        <- workspace, testSuite, commitMessage
        -> testSuiteCommit: ext=".txt"
        timeout 600
    }

    finish := internal mhdg-nrvv.finish-run {
        name "Close the NRVV run record - FINISHED with the pushed commit, or ERROR when any Task failed"
        <- runId
        timeout 60
        tag terminal
    }
}
