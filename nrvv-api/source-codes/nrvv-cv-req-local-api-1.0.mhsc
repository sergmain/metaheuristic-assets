// API TWIN of nrvv-cv-req-local-1.0.mhsc - generated by nrvv/tools/api_twin.py (plan 052): every model call site
// on the API code of its Function, with llm_provider = "claude_api". Do not edit: regenerate from the base.

// NRVV cv-req-local 1.0: local contradiction - can each changed requirement hold together with the requirements near it?
// The subjects are the run's scope (the requirements a repair changed), read at their ACTIVE rows; each is judged
// against its candidates only - parent, siblings, children, the items it reads under and the requirements naming them,
// the requirements citing a NEED it cites, the Interface and Environment items, then the requirements sharing the most
// words with it, at most 60 - never against the whole set. Per subject CC names every candidate that cannot hold together
// with it, with a witness situation: one REQ_CONTRADICTION (hard) each. One NEEDS_CV run of workflow LOCAL_CONTRADICTION.
// Started by the Dispatcher, never by hand: the run record NRVV_RUN #runId exists before this ExecContext does and names
// its snapshot and scope, and mhdg-nrvv.finish-run closes it.
//
//   read     internal mhdg-nrvv.read-local-cv-input           the subjects at the run's snapshot, one per line
//                                                              (nullified when there is none: no branch, no finding),
//                                                              and the context: per subject its text and its candidates
//   split    internal mh.batch-line-splitter                  one branch per subject
//     lprompt  mh.asset.nrvv-cv-req-local-prompt_1.0          the prompt for the subject and its candidates
//     cc       mh.asset.call-cc_1.2                           CC answers {"subject", "contradictions": [...]}
//     lcheck   mh.asset.nrvv-cv-req-local-check_1.0           the answer checked - the subject judged, counterparts
//                                                              among its candidates, once each, with a situation; a
//                                                              broken rule is written as a refusal, and the Task succeeds
//     store    internal mhdg-nrvv.store-findings               one REQ_CONTRADICTION per counterpart, or the refusal;
//                                                              checked again against the candidates the Dispatcher
//                                                              computes itself; a subject is written once
//   finish   internal mhdg-nrvv.finish-run                    the run record FINISHED, or ERROR when any Task failed
//
// No STAGE: the run reads RG and writes NRVV only. No checkout, no workspace, no credential.
//
// Inputs: exactly NrvvRunUtils.needsCvVariables (MH refuses a missing or an undeclared name). `model` is declared
// without '?': NrvvRunService refuses a blank model.
//
// ORDER is declaration order: each process is chained to the one declared before it; inside a branch the steps run in
// order; finish runs last, after failures too (tag terminal). No cache on cc: each attempt of a group is asked again.

source "nrvv-cv-req-local-api-1.0" {

    variables {
        <- production?
        <- runId
        <- model
        <- effort?
    }

    read := internal mhdg-nrvv.read-local-cv-input {
        name "Read the changed requirements and their candidates at the run's snapshot"
        <- runId
        -> subjects: ext=".txt",
           localCvContext: ext=".json"
        timeout 120
    }

    split := internal mh.batch-line-splitter {
        name "One branch per changed requirement"
        meta number-of-lines-per-task = "1",
             variable-for-splitting = "subjects",
             output-is-dynamic = "true",
             output-variable = "subject",
             is-array = "false"
        <- subjects
        sequential {
            lprompt := mh.asset.nrvv-cv-req-local-prompt_1.0 {
                name "Build the LOCAL_CONTRADICTION prompt: the requirement and its candidates"
                meta variable-for-local-cv-context = "localCvContext",
                     variable-for-subjects = "subject",
                     variable-for-prompt = "localCvPrompt"
                <- localCvContext, subject
                -> localCvPrompt: ext=".txt"
                timeout 60
            }

            cc := mh.asset.call-cc-api_1.0 {
                name "Ask CC which candidates cannot hold together with the requirement"
                // the process timeout must be larger than timeout-sec, or MH kills the Task before it can say why
                meta llm_provider = "claude_api",
                     variable-for-prompt = "localCvPrompt",
                     variable-for-output = "localCvResult",
                     variable-for-model = "model",
                     variable-for-effort = "effort",
                     timeout-sec = "900"
                <- localCvPrompt, model, effort?
                -> localCvResult: ext=".txt"
                timeout 1200
                tries 2
            }

            lcheck := mh.asset.nrvv-cv-req-local-check_1.0 {
                name "Check CC's answer and hand it on in canonical form, or as a refusal"
                meta variable-for-cc-result = "localCvResult",
                     variable-for-local-cv-context = "localCvContext",
                     variable-for-subjects = "subject",
                     variable-for-findings = "findings"
                <- localCvResult, localCvContext, subject
                -> findings: ext=".json"
                timeout 60
            }

            store := internal mhdg-nrvv.store-findings {
                name "Store one REQ_CONTRADICTION per counterpart, or the refusal - checked again by the Dispatcher"
                <- runId, findings
                timeout 120
            }
        }
    }

    finish := internal mhdg-nrvv.finish-run {
        name "Close the NRVV run record - FINISHED, or ERROR when any Task failed"
        <- runId
        timeout 60
        tag terminal
    }
}
