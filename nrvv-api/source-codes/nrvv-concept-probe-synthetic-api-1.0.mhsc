// API TWIN of nrvv-concept-probe-synthetic-1.0.mhsc - generated by nrvv/tools/api_twin.py (plan 052): every model call site
// on the API code of its Function, with llm_provider = "claude_api". Do not edit: regenerate from the base.

// NRVV concept probe 1.0 - SYNTHETIC (plan 050 Phase 2, decisions 10 and 12): does concept analysis find the load-bearing
// terms of a text, and do independent readings sessions agree on what they mean? A go / no-go experiment before
// anything of decision 10 is built into NRVV. It writes NO RG and NO NRVV record: its only output is a meta-storage
// table of its own (one per ExecContext, the synthetic store unless production is exactly 'true').
//
//   tprompt  mh.asset.nrvv-concept-terms-prompt_1.0     the terms prompt over the concept input
//   tcc      mh.asset.call-cc_1.2                       ONE session lists the terms, each with 2 - 4 candidate readings,
//                                                       every reading quoting the words of the text it rests on
//   tcheck   mh.asset.nrvv-concept-terms-check_1.0      the answer checked (verbatim rule; a failing term set aside and
//                                                       recorded), the readings lettered; the session numbers 1 .. 3
//   split    internal mh.batch-line-splitter            one branch per readings session (3), started together
//     rprompt  mh.asset.nrvv-concept-readings-prompt_1.0  the session's prompt - readings rotated by the session number
//     rcc      mh.asset.call-cc_1.2                     a fresh session, blind to the others, picks per term a reading
//                                                       with a quote, or OPEN
//     rcheck   mh.asset.nrvv-concept-readings-check_1.0  the picks checked; one line of JSON per session
//   gather   internal mh.aggregate                      the sessions' picks, one line each
//   agree    mh.asset.nrvv-concept-agree_1.0            CONFIRMED when two sessions pick one reading; else OPEN
//   register internal mh.meta-storage-registry          what the table is, before a record exists in it
//   store    internal mh.meta-storage                   one record per term, then the summary
//
// Inputs (source-level, mh_create_exec_context_with_variables):
//   conceptInput  {"expectation": "<text>", "needs": [{"reqId", "kind", "title", "statement"}]}
//   probeLabel    nullable: what the probe runs on (e.g. "r1 - NEEDs of #95"), written into the table's description
//   production    'true' selects the production meta store; anything else the synthetic one
//   model         the model of every session; effort - nullable (ignored on the API path)
//
// ORDER is declaration order: each process is chained to the one declared before it; inside a branch the steps run in
// order. No cache on the model calls: each session is asked afresh.

source "nrvv-concept-probe-synthetic-api-1.0" {

    variables {
        <- conceptInput
        <- probeLabel?
        <- production
        <- model
        <- effort?
    }

    tprompt := mh.asset.nrvv-concept-terms-prompt_1.0 {
        name "Build the terms prompt: the expectation and its NEEDs"
        meta variable-for-concept-input = "conceptInput",
             variable-for-prompt = "termsPrompt"
        <- conceptInput
        -> termsPrompt: ext=".txt"
        timeout 60
    }

    tcc := mh.asset.call-cc-api_1.0 {
        name "Ask for the load-bearing terms, each with its candidate readings"
        // the process timeout must be larger than timeout-sec, or MH kills the Task before it can say why
        meta llm_provider = "claude_api",
             variable-for-prompt = "termsPrompt",
             variable-for-output = "termsResult",
             variable-for-model = "model",
             variable-for-effort = "effort",
             timeout-sec = "900"
        <- termsPrompt, model, effort?
        -> termsResult: ext=".txt"
        timeout 1200
        tries 2
    }

    tcheck := mh.asset.nrvv-concept-terms-check_1.0 {
        name "Check the terms, letter their readings, and number the readings sessions"
        meta variable-for-cc-result = "termsResult",
             variable-for-concept-input = "conceptInput",
             variable-for-terms = "terms",
             variable-for-sessions = "sessions"
        <- termsResult, conceptInput
        -> terms: ext=".json",
           sessions: ext=".txt"
        timeout 60
    }

    split := internal mh.batch-line-splitter {
        name "One branch per readings session - the sessions are independent"
        meta number-of-lines-per-task = "1",
             variable-for-splitting = "sessions",
             output-is-dynamic = "true",
             output-variable = "sessionChunk",
             is-array = "false"
        <- sessions
        sequential {
            rprompt := mh.asset.nrvv-concept-readings-prompt_1.0 {
                name "Build the session's readings prompt - the readings rotated by the session number"
                meta variable-for-concept-input = "conceptInput",
                     variable-for-terms = "terms",
                     variable-for-session = "sessionChunk",
                     variable-for-prompt = "readingsPrompt"
                <- conceptInput, terms, sessionChunk
                -> readingsPrompt: ext=".txt"
                timeout 60
            }

            rcc := mh.asset.call-cc-api_1.0 {
                name "Ask a fresh session to pick per term the reading the text supports, or OPEN"
                meta llm_provider = "claude_api",
                     variable-for-prompt = "readingsPrompt",
                     variable-for-output = "readingsResult",
                     variable-for-model = "model",
                     variable-for-effort = "effort",
                     timeout-sec = "900"
                <- readingsPrompt, model, effort?
                -> readingsResult: ext=".txt"
                timeout 1200
                tries 2
            }

            rcheck := mh.asset.nrvv-concept-readings-check_1.0 {
                name "Check the session's picks and hand them on as one line"
                meta variable-for-cc-result = "readingsResult",
                     variable-for-concept-input = "conceptInput",
                     variable-for-terms = "terms",
                     variable-for-session = "sessionChunk",
                     variable-for-readings = "readings"
                <- readingsResult, conceptInput, terms, sessionChunk
                -> readings: ext=".json"
                timeout 60
            }
        }
    }

    gather := internal mh.aggregate {
        name "Collect every session's picks"
        // collects by NAME across the whole ExecContext - a branch's variable is invisible at the top level
        meta variables = "readings",
             type = "text",
             produce-metadata = "false",
             error-control-policy = "fail"
        -> allReadings: ext=".txt"
        timeout 300
    }

    agree := mh.asset.nrvv-concept-agree_1.0 {
        name "Agree: a reading two sessions picked is CONFIRMED, anything else OPEN"
        meta variable-for-terms = "terms",
             variable-for-all-readings = "allReadings",
             variable-for-label = "probeLabel",
             variable-for-production = "production",
             variable-for-records = "conceptRecords",
             variable-for-summary = "conceptSummary",
             variable-for-meta-storage-type = "metaStorageType",
             variable-for-synthetic-flag = "syntheticFlag",
             variable-for-table-desc = "tableDesc",
             variable-for-table-rec-key-format = "tableRecKeyFormat",
             variable-for-table-body-format = "tableBodyFormat",
             variable-for-table-consumer = "tableConsumer"
        <- terms, allReadings, probeLabel?, production
        -> conceptRecords: ext=".json",
           conceptSummary: ext=".json",
           metaStorageType: ext=".txt",
           syntheticFlag: ext=".txt",
           tableDesc: ext=".txt",
           tableRecKeyFormat: ext=".txt",
           tableBodyFormat: ext=".txt",
           tableConsumer: ext=".txt"
        timeout 60
    }

    register := internal mh.meta-storage-registry {
        name "Register what this probe's table is - before a record exists in it"
        meta meta-table = "metaStorageType",
             production = "production",
             desc = "tableDesc",
             rec-key-format = "tableRecKeyFormat",
             body-format = "tableBodyFormat",
             consumer = "tableConsumer"
        <- metaStorageType, production, tableDesc, tableRecKeyFormat, tableBodyFormat, tableConsumer
        timeout 60
    }

    store := internal mh.meta-storage {
        name "Upsert one record per term and the summary into the probe's table"
        meta action = "upsert",
             type = "metaStorageType",
             synthetic = "syntheticFlag",
             content = "conceptRecords"
        <- metaStorageType, syntheticFlag, conceptRecords
        timeout 120
    }
}
