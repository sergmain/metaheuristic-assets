// API TWIN of nrvv-cv-need-completeness-1.0.mhsc - generated by nrvv/tools/api_twin.py (plan 052): every model call site
// on the API code of its Function, with llm_provider = "claude_api". Do not edit: regenerate from the base.

// NRVV cv-need-completeness 1.0: completeness (INCOSE C10) - per derivation NEED, do its top-level requirements, read
// under the items that govern it, guarantee what the NEED requires? The subjects are the derivation NEEDs at the run's
// snapshot, or the run's scope when it names one. Per NEED CC answers exactly one verdict: MET (no finding) or NOT_MET
// with the situation the NEED requires and its requirements do not guarantee (NEED_NOT_MET - hard). One NEEDS_CV run of
// workflow COMPLETENESS. Started by the Dispatcher, never by hand: the run record NRVV_RUN #runId exists before this
// ExecContext does and names its snapshot, and mhdg-nrvv.finish-run closes it.
//
//   read     internal mhdg-nrvv.read-completeness-input         the subjects at the run's snapshot, one per line
//                                                                (nullified when there is none: no chunk, no finding),
//                                                                and the context: per NEED its governing items and its
//                                                                top-level requirements
//   split    internal mh.batch-line-splitter                    one branch per chunk of at most 10 NEEDs
//     cprompt  mh.asset.nrvv-cv-need-completeness-prompt_1.0    the prompt for the chunk
//     cc       mh.asset.call-cc_1.2                             CC answers {"verdicts": [...]}, one per NEED of the
//                                                                chunk
//     ccheck   mh.asset.nrvv-cv-need-completeness-check_1.0     the answer checked - every NEED of the chunk once,
//                                                                MET or NOT_MET, NOT_MET with its situation; a broken
//                                                                rule is written as a refusal of the chunk, and the Task
//                                                                succeeds
//     store    internal mhdg-nrvv.store-findings                 one NEED_NOT_MET per NOT_MET, or the refusal per NEED of
//                                                                the chunk; checked again against what the Dispatcher
//                                                                reads itself; a chunk is written once
//   finish   internal mhdg-nrvv.finish-run                      the run record FINISHED, or ERROR when any Task failed
//
// No STAGE: the run reads RG and writes NRVV only. No checkout, no workspace, no credential.
//
// Inputs: exactly NrvvRunUtils.needsCvVariables (MH refuses a missing or an undeclared name). `model` is declared
// without '?': NrvvRunService refuses a blank model.
//
// ORDER is declaration order: each process is chained to the one declared before it; inside a branch the steps run in
// order; finish runs last, after failures too (tag terminal). No cache on cc: each attempt of a group is asked again.

source "nrvv-cv-need-completeness-api-1.0" {

    variables {
        <- production?
        <- runId
        <- model
        <- effort?
    }

    read := internal mhdg-nrvv.read-completeness-input {
        name "Read the derivation NEEDs, their governing items and their top-level requirements at the run's snapshot"
        <- runId
        -> subjects: ext=".txt",
           completenessContext: ext=".json"
        timeout 120
    }

    split := internal mh.batch-line-splitter {
        name "One branch per chunk of at most 10 NEEDs"
        meta number-of-lines-per-task = "10",
             variable-for-splitting = "subjects",
             output-is-dynamic = "true",
             output-variable = "subjectChunk",
             is-array = "false"
        <- subjects
        sequential {
            cprompt := mh.asset.nrvv-cv-need-completeness-prompt_1.0 {
                name "Build the COMPLETENESS prompt for the chunk: each NEED, its governing items, its requirements"
                meta variable-for-completeness-context = "completenessContext",
                     variable-for-subjects = "subjectChunk",
                     variable-for-prompt = "completenessPrompt"
                <- completenessContext, subjectChunk
                -> completenessPrompt: ext=".txt"
                timeout 60
            }

            cc := mh.asset.call-cc-api_1.0 {
                name "Ask CC for one verdict per NEED of the chunk"
                // the process timeout must be larger than timeout-sec, or MH kills the Task before it can say why
                meta llm_provider = "claude_api",
                     variable-for-prompt = "completenessPrompt",
                     variable-for-output = "completenessResult",
                     variable-for-model = "model",
                     variable-for-effort = "effort",
                     timeout-sec = "900"
                <- completenessPrompt, model, effort?
                -> completenessResult: ext=".txt"
                timeout 1200
                tries 2
            }

            ccheck := mh.asset.nrvv-cv-need-completeness-check_1.0 {
                name "Check CC's verdicts and hand them on in canonical form, or as a refusal of the chunk"
                meta variable-for-cc-result = "completenessResult",
                     variable-for-completeness-context = "completenessContext",
                     variable-for-subjects = "subjectChunk",
                     variable-for-findings = "findings"
                <- completenessResult, completenessContext, subjectChunk
                -> findings: ext=".json"
                timeout 60
            }

            store := internal mhdg-nrvv.store-findings {
                name "Store one NEED_NOT_MET per NOT_MET, or the refusal per NEED - checked again by the Dispatcher"
                <- runId, findings
                timeout 120
            }
        }
    }

    finish := internal mhdg-nrvv.finish-run {
        name "Close the NRVV run record - FINISHED, or ERROR when any Task failed"
        <- runId
        timeout 60
        tag terminal
    }
}
