// API TWIN of nrvv-repair-1.0.mhsc - generated by nrvv/tools/api_twin.py (plan 052): every model call site
// on the API code of its Function, with llm_provider = "claude_api". Do not edit: regenerate from the base.

// NRVV repair 1.0: one iteration of the convergence loop - the open hard findings of a failed gate (the run's reasons),
// partitioned into components that share no requirement, each repaired by its own CC session with small changes: KEEP,
// CHANGE or OBSOLETE every item the component names, ADD what is missing. Every component is written into ONE STAGE; the
// RG writes are serialized per STAGE, the CC sessions run in parallel. One REPAIR run per iteration. Started by the
// Dispatcher (the chain, or a person's resume of a NOT_CONVERGED decline), never by hand: the run record NRVV_RUN #runId
// exists before this ExecContext does and names its baseline, its reasons, its loop's gate stage and its level, and
// mhdg-nrvv.finish-run closes it.
//
//   open       internal mhdg-nrvv.open-stage              ONE STAGE on the run's baseline: stageSnapshotId
//   context    internal mhdg-nrvv.read-repair-context     repairContext - per component its findings, items, NEEDs and the
//                                                          loop's earlier iterations - and components (one id per line)
//   repairs    internal mh.batch-line-splitter            one branch per component, in parallel
//     rprompt  mh.asset.nrvv-repair-prompt_1.0            the prompt: the findings, the items, the "which side" rules, the
//                                                          earlier iterations; the answer instruction last
//     rcc      mh.asset.call-cc_1.2                       CC answers {"decisions": [...], "add": [...]}
//     rcheck   mh.asset.nrvv-repair-check_1.0             the answer checked - every item decided once, the evidence
//                                                          rules, coverage kept; a broken rule is written as a refusal,
//                                                          and the Task succeeds
//     rstore   internal mhdg-nrvv.store-repair            the component's changes written into the STAGE, or one
//                                                          ANSWER_REFUSED; checked again by the Dispatcher
//   close      internal mhdg-rg.post-processing           commits the STAGE - marked FAILED instead if any Task failed
//   finish     internal mhdg-nrvv.finish-run              the run FINISHED with its snapshot, the line extended
//
// Inputs: exactly NrvvRunUtils.definitionBaselineVariables (MH refuses a missing or an undeclared name). `model` is
// declared without '?': NrvvRunService refuses a REPAIR with no pair at its level.
//
// ORDER is declaration order; inside a branch the steps run in order; close and finish run last, after failures too
// (tag terminal). No cache on rcc: an iteration is asked again.

source "nrvv-repair-api-1.0" {

    variables {
        <- production?
        <- runId, projectCode
        <- model
        <- effort?
    }

    open := internal mhdg-nrvv.open-stage {
        name "Open ONE STAGE on the run's baseline"
        <- runId
        -> stageSnapshotId: ext=".txt"
        timeout 300
    }

    context := internal mhdg-nrvv.read-repair-context {
        name "Read the components of the run's reasons and what each repairs at the run's snapshot"
        <- runId
        -> repairContext: ext=".json",
           components: ext=".txt"
        timeout 120
    }

    repairs := internal mh.batch-line-splitter {
        name "One branch per component"
        meta number-of-lines-per-task = "1",
             variable-for-splitting = "components",
             output-is-dynamic = "true",
             output-variable = "component",
             is-array = "false"
        <- components
        sequential {
            rprompt := mh.asset.nrvv-repair-prompt_1.0 {
                name "Build the REPAIR prompt of the component"
                meta variable-for-repair-context = "repairContext",
                     variable-for-components = "component",
                     variable-for-prompt = "repairPrompt"
                <- repairContext, component
                -> repairPrompt: ext=".txt"
                timeout 60
            }

            rcc := mh.asset.call-cc-api_1.0 {
                name "Ask CC for the component's repair"
                // the process timeout must be larger than timeout-sec, or MH kills the Task before it can say why
                meta llm_provider = "claude_api",
                     variable-for-prompt = "repairPrompt",
                     variable-for-output = "repairResult",
                     variable-for-model = "model",
                     variable-for-effort = "effort",
                     timeout-sec = "900"
                <- repairPrompt, model, effort?
                -> repairResult: ext=".txt"
                timeout 1200
                tries 2
            }

            rcheck := mh.asset.nrvv-repair-check_1.0 {
                name "Check the repair - a broken rule is written as a refusal"
                meta variable-for-cc-result = "repairResult",
                     variable-for-repair-context = "repairContext",
                     variable-for-components = "component",
                     variable-for-repair = "repairAnswer"
                <- repairResult, repairContext, component
                -> repairAnswer: ext=".json"
                timeout 60
            }

            rstore := internal mhdg-nrvv.store-repair {
                name "Write the component's repair into the STAGE - checked again by the Dispatcher"
                meta answer = "repairAnswer",
                     component = "component"
                <- runId, stageSnapshotId, repairAnswer, component
                timeout 1800
            }
        }
    }

    close := internal mhdg-rg.post-processing {
        name "Commit the STAGE - marked FAILED instead if any Task failed"
        <- projectCode, stageSnapshotId
        timeout 60
        tag terminal
    }

    finish := internal mhdg-nrvv.finish-run {
        name "Close the NRVV run record - FINISHED with its snapshot, or ERROR when any Task failed"
        <- runId
        timeout 60
        tag terminal
    }
}
