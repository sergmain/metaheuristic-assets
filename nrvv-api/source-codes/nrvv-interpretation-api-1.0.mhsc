// API TWIN of nrvv-interpretation-1.0.mhsc - generated by nrvv/tools/api_twin.py (plan 052): every model call site
// on the API code of its Function, with llm_provider = "claude_api". Do not edit: regenerate from the base.

// NRVV interpretation 1.0: the NEED interpretation - the agreed NEEDs read as a set before any requirement is written.
// Each session states atomic ASSUMPTION, READING and OPEN_CHOICE items, each citing the NEEDs it rests on and quoting
// their words; the items are written into ONE STAGE, in the SECTION NRVV:INTERPRETATION, each with a TRACE edge from
// every NEED it cites. One INTERPRETATION run per project. Started by the Dispatcher (POST
// /rest/v1/nrvv/projects/{id}/interpretation, or the chain), never by hand: the run record NRVV_RUN #runId exists
// before this ExecContext does, names its baseline, and mhdg-nrvv.finish-run closes it.
//
//   open      internal mhdg-nrvv.open-stage              ONE STAGE on the run's baseline: stageSnapshotId
//   input     internal mhdg-nrvv.read-interpretation-input  the NEEDs, the sections of the expectation, the sessions;
//                                                         firstSession, and localSessions one per line (nullified when
//                                                         there is none: no branch)
//   the first session, alone, first - its checked answer `interpretation` is shown read-only to every later session
//     fprompt   mh.asset.nrvv-interpretation-prompt_1.0
//     fcc       mh.asset.call-cc_1.2
//     fcheck    mh.asset.nrvv-interpretation-check_1.0      the items in canonical form, or {"refused": ...}
//     fstore    internal mhdg-nrvv.store-interpretation   the items into the STAGE; a refusal as ANSWER_REFUSED findings
//   split     internal mh.batch-line-splitter            one branch per later session, in parallel
//     lprompt / lcc / lcheck / lstore                     the same steps for the branch's session
//   close     internal mhdg-rg.post-processing           commits the STAGE - marked FAILED instead if any Task failed
//   finish    internal mhdg-nrvv.finish-run              the run FINISHED with its result snapshot, the line extended
//
// Inputs: exactly NrvvRunUtils.definitionBaselineVariables (MH refuses a missing or an undeclared name).
//
// ORDER is declaration order: each process is chained to the one declared before it; inside a branch the steps run in
// order; close and finish run last, after failures too (tag terminal). No cache on cc.

source "nrvv-interpretation-api-1.0" {

    variables {
        <- production?
        <- runId, projectCode
        <- model
        <- effort?
    }

    open := internal mhdg-nrvv.open-stage {
        name "Open ONE STAGE on the run's baseline"
        <- runId
        -> stageSnapshotId: ext=".txt"
        timeout 300
    }

    input := internal mhdg-nrvv.read-interpretation-input {
        name "Read the NEEDs, the sections of the expectation and the sessions"
        <- runId
        -> interpretationInput: ext=".json",
           firstSession: ext=".txt",
           localSessions: ext=".txt"
        timeout 120
    }

    fprompt := mh.asset.nrvv-interpretation-prompt_1.0 {
        name "Build the prompt of the first session"
        meta variable-for-interpretation-input = "interpretationInput",
             variable-for-session = "firstSession",
             variable-for-prompt = "firstPrompt"
        <- interpretationInput, firstSession
        -> firstPrompt: ext=".txt"
        timeout 60
    }

    fcc := mh.asset.call-cc-api_1.0 {
        name "Ask CC for the items of the first session"
        // the process timeout must be larger than timeout-sec, or MH kills the Task before it can say why
        meta llm_provider = "claude_api",
             variable-for-prompt = "firstPrompt",
             variable-for-output = "firstResult",
             variable-for-model = "model",
             variable-for-effort = "effort",
             timeout-sec = "900"
        <- firstPrompt, model, effort?
        -> firstResult: ext=".txt"
        timeout 1200
        tries 2
    }

    fcheck := mh.asset.nrvv-interpretation-check_1.0 {
        name "Check the first session's items - a broken rule is written as a refusal"
        meta variable-for-cc-result = "firstResult",
             variable-for-interpretation-input = "interpretationInput",
             variable-for-session = "firstSession",
             variable-for-interpretation = "interpretation"
        <- firstResult, interpretationInput, firstSession
        -> interpretation: ext=".json"
        timeout 60
    }

    fstore := internal mhdg-nrvv.store-interpretation {
        name "Write the first session's items into the STAGE - checked again by the Dispatcher"
        meta session = "firstSession"
        <- runId, stageSnapshotId, interpretationInput, interpretation, firstSession
        timeout 1800
    }

    split := internal mh.batch-line-splitter {
        name "One branch per later session"
        meta number-of-lines-per-task = "1",
             variable-for-splitting = "localSessions",
             output-is-dynamic = "true",
             output-variable = "session",
             is-array = "false"
        <- localSessions
        sequential {
            lprompt := mh.asset.nrvv-interpretation-prompt_1.0 {
                name "Build the prompt of the branch's session, with the first session's items read-only"
                meta variable-for-interpretation-input = "interpretationInput",
                     variable-for-session = "session",
                     variable-for-first-answer = "interpretation",
                     variable-for-prompt = "localPrompt"
                <- interpretationInput, session, interpretation
                -> localPrompt: ext=".txt"
                timeout 60
            }

            lcc := mh.asset.call-cc-api_1.0 {
                name "Ask CC for the items of the branch's session"
                meta llm_provider = "claude_api",
                     variable-for-prompt = "localPrompt",
                     variable-for-output = "localResult",
                     variable-for-model = "model",
                     variable-for-effort = "effort",
                     timeout-sec = "900"
                <- localPrompt, model, effort?
                -> localResult: ext=".txt"
                timeout 1200
                tries 2
            }

            lcheck := mh.asset.nrvv-interpretation-check_1.0 {
                name "Check the branch's items - a broken rule is written as a refusal"
                meta variable-for-cc-result = "localResult",
                     variable-for-interpretation-input = "interpretationInput",
                     variable-for-session = "session",
                     variable-for-interpretation = "localInterpretation"
                <- localResult, interpretationInput, session
                -> localInterpretation: ext=".json"
                timeout 60
            }

            lstore := internal mhdg-nrvv.store-interpretation {
                name "Write the branch's items into the STAGE - one writer per STAGE at a time"
                meta session = "session",
                     answer = "localInterpretation"
                <- runId, stageSnapshotId, interpretationInput, localInterpretation, session
                timeout 1800
            }
        }
    }

    close := internal mhdg-rg.post-processing {
        name "Commit the STAGE - marked FAILED instead if any Task failed"
        <- projectCode, stageSnapshotId
        timeout 60
        tag terminal
    }

    finish := internal mhdg-nrvv.finish-run {
        name "Close the NRVV run record - FINISHED with its result snapshot, or ERROR when any Task failed"
        <- runId
        timeout 60
        tag terminal
    }
}
