// DSL for .mhsc/.mhscp is described in /mnt/shared/metaheuristic.wiki/p/source-code-dsl.md
//
// The YC update: signs in with the YC account in Vault entry VC_YC_AUTH, reads the update form of the application at
// formUrl - one that is already submitted - and submits an update with every answer this run brings that differs from
// what YC holds, the way YC's own "Submit update" button does. Never a first submit: that is vc-apply-yc-1.0's
// territory up to the save and the founder's act beyond it.
//
// Its mode is the production input (DAHF §0.15): exactly true -> the update is submitted and the application read back;
// anything else (launch with JSON null) -> synthetic: everything is read and the update is computed, nothing is sent.
//
// The answers are the global input Variables the YC form survey defined (vc-form-survey-yc-synthetic-1.0, E5,
// ExecContext #5406), the same set vc-apply-yc-1.0 declares: one input per question of the form, yc + the question in
// PascalCase. Every one is nullable: a null leaves that question as YC holds it. An answer to a question the update form
// does not offer refuses the run before anything is written - after a submit YC keeps only some questions editable.
//
// Launch with mh_create_exec_context_with_variables (source-level inputs, 562.120): formUrl, production, and every
// yc* input - null where the question is to stay as it is. Run it in a company whose Vault - or the management
// company's, whose keys have priority - holds VC_YC_AUTH (vc-application/DETAILS.md, section C).

source "vc-update-yc-1.0" {

    variables {
        <- formUrl
        <- production?
        <- ycFounderBios?
        <- ycMeet?
        <- ycOthers2?
        <- ycCofounder?
        <- ycVideo?
        <- ycVideoS3Key?
        <- ycName?
        <- ycDescribe?
        <- ycUrl?
        <- ycDemo?
        <- ycDemoS3Key?
        <- ycProductLink?
        <- ycProductCreds?
        <- ycMake?
        <- ycWhere?
        <- ycWherewhy?
        <- ycHowfar?
        <- ycWorked?
        <- ycTechstack?
        <- ycCodingAgentSession?
        <- ycStage?
        <- ycUsernums?
        <- ycWhenbeta?
        <- ycRevenue?
        <- ycRevenueamount?
        <- ycRevenuesource?
        <- ycGrowthrate?
        <- ycSince?
        <- ycAcc?
        <- ycExp?
        <- ycGet?
        <- ycMoney?
        <- ycIdeas?
        <- ycIncyet?
        <- ycInctype?
        <- ycIncpercent?
        <- ycPercent2?
        <- ycInvestyet?
        <- ycIncinvest?
        <- ycInvestamount?
        <- ycBank?
        <- ycBurn?
        <- ycRunway?
        <- ycCurrentlyraising?
        <- ycRaisingdetails?
        <- ycWhyapply?
        <- ycHowhear?
        <- ycReferralCode?
        <- ycBatchPreference?
        <- ycFutureBatchName?
        <- ycFutureBatchWhy?
        -> currentAnswers
        -> updatePatch
        -> updateResult
    }

    update := mh.asset.vc-update-yc_1.0 {
        name "Submit an update to a submitted VC application from the run's answers"
        // Every name the Function reads or writes is bound here, never inside it.
        meta fund = "yc",
             variable-prefix = "yc",
             variable-for-form-url = "formUrl",
             variable-for-production = "production",
             variable-for-current-answers = "currentAnswers",
             variable-for-update-patch = "updatePatch",
             variable-for-update-result = "updateResult"
        <- formUrl, production?,
           ycFounderBios?, ycMeet?, ycOthers2?, ycCofounder?, ycVideo?, ycVideoS3Key?, ycName?, ycDescribe?, ycUrl?,
           ycDemo?, ycDemoS3Key?, ycProductLink?, ycProductCreds?, ycMake?, ycWhere?, ycWherewhy?, ycHowfar?,
           ycWorked?, ycTechstack?, ycCodingAgentSession?, ycStage?, ycUsernums?, ycWhenbeta?, ycRevenue?,
           ycRevenueamount?, ycRevenuesource?, ycGrowthrate?, ycSince?, ycAcc?, ycExp?, ycGet?, ycMoney?, ycIdeas?,
           ycIncyet?, ycInctype?, ycIncpercent?, ycPercent2?, ycInvestyet?, ycIncinvest?, ycInvestamount?, ycBank?,
           ycBurn?, ycRunway?, ycCurrentlyraising?, ycRaisingdetails?, ycWhyapply?, ycHowhear?, ycReferralCode?,
           ycBatchPreference?, ycFutureBatchName?, ycFutureBatchWhy?
        -> currentAnswers: ext=".json",
           updatePatch: ext=".json",
           updateResult: ext=".json"
        // The sign-in (up to five requests), the form page, and at most three GraphQL calls of at most 20 s each,
        // plus the 10 s window of the secret handshake.
        timeout 240
        // A sign-in that failed is not repeated (another attempt only moves the site toward a captcha), and an update
        // whose outcome is unknown is not submitted twice.
        tries 1
    }
}
